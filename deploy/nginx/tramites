# Copia de /etc/nginx/sites-available/tramites de la VM (192.168.7.61), tomada el 17-nov-2026.
# Habilitado en /etc/nginx/sites-enabled/tramites (el sitio "default" del paquete NO está habilitado).
# El certificado y la llave viven solo en la VM (/etc/nginx/ssl/); nunca se versionan.
server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2 default_server;
    server_name _;
    ssl_certificate /etc/nginx/ssl/tramites.crt;
    ssl_certificate_key /etc/nginx/ssl/tramites.key;
    # Debe ser mayor que el tope de subida más alto de la plataforma (planos y concepto técnico: 10 MB).
    client_max_body_size 60m;
    proxy_read_timeout 300s;
    proxy_hide_header X-Powered-By;
    # nosniff y Referrer-Policy también los envía la aplicación (next.config.ts); el navegador los
    # recibe duplicados con el mismo valor, sin efecto. HSTS se agregará cuando haya dominio y certificado.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_redirect https://localhost:3000/ /;
        proxy_redirect http://localhost:3000/ /;
        proxy_set_header X-Forwarded-Host $host;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
