# Copiar a .env.local y completar con los valores reales (nunca commitear .env.local)

# Conexión pooled (Supavisor, transaction mode) - la usa la app en runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexión directa (session mode) - la usa Prisma solo para migraciones
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# Supabase (Settings > API en el dashboard del proyecto)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Secreto para firmar las cookies de sesión (generar con: openssl rand -hex 32)
SESSION_SECRET=""

# Conexión por directorio activo CDMB (API externa, Laravel/Sanctum)
# Si DIRECTORIO_ACTIVO_API_URL queda vacío, la opción no se muestra en /login.
DIRECTORIO_ACTIVO_API_URL=""
DIRECTORIO_ACTIVO_CLIENTE="web"  # uno de: web | app | postman | desktop

# SINCA 1.0 — histórico de resoluciones de fondo (API externo Laravel).
# Cuenta de servicio para la sincronización. Si SINCA_API_URL queda vacío,
# la sección "SINCA 1.0" no aparece en la navegación.
SINCA_API_URL=""
SINCA_API_CLIENTE="web"
SINCA_API_USUARIO=""
SINCA_API_PASSWORD=""
CRON_SECRET=""  # secreto que valida el cron diario de Vercel (openssl rand -hex 16)
