# Copiar a .env.local y completar con los valores reales (nunca commitear .env.local)

# PostgreSQL de la VM. connection_limit = conexiones máximas de la app (20 en producción).
DATABASE_URL="postgresql://<usuario>:<clave>@127.0.0.1:5432/tramites?connection_limit=20"

# Conexión directa que usa Prisma para `prisma db push`
DIRECT_URL="postgresql://<usuario>:<clave>@127.0.0.1:5432/tramites"

# Dirección pública de la plataforma (enlaces de los correos y sello de las firmas)
URL_PLATAFORMA="https://<nombre-de-la-plataforma>"
# Negocios Verdes: dirección de QR, enlaces para compartir y sitemap. Vacía = la dirección por la que entra cada persona.
# Mientras no haya certificado, p. ej. "http://sic.cdmb.gov.co"; con certificado, "https://sic.cdmb.gov.co".
URL_PUBLICA_NV=""

# Carpeta del NAS donde viven todos los archivos (obligatoria)
ALMACEN_LOCAL_DIR="/mnt/nas/almacen"

# Secreto para firmar las cookies de sesión (generar con: openssl rand -hex 32)
SESSION_SECRET=""

# Conexión por directorio activo CDMB (API externa, Laravel/Sanctum)
# Si DIRECTORIO_ACTIVO_API_URL queda vacío, la opción no se muestra en /login.
DIRECTORIO_ACTIVO_API_URL=""
DIRECTORIO_ACTIVO_CLIENTE="web"  # uno de: web | app | postman | desktop

# SINCA 1.0 — histórico de resoluciones de fondo (API externo Laravel).
# Cuenta de servicio para la sincronización. Si SINCA_API_URL queda vacío,
# la sección "SINCA 1.0" no aparece en la navegación.
SINCA_API_URL=""
SINCA_API_CLIENTE="web"
SINCA_API_USUARIO=""
SINCA_API_PASSWORD=""
CRON_SECRET=""  # secreto que valida los temporizadores de la VM (openssl rand -hex 16)

# VITAL (MinAmbiente) — vía el proxy X-Road de la CDMB (mismo host que SINCA).
# Si falta alguna, la sección VITAL sale "no configurada". Solo lectura.
VITAL_API_URL=""            # ej. http://168.90.14.182/api/vital
VITAL_XROAD_URL=""          # ej. http://192.168.7.74/r1/CO/GOB/MADS-8003/VITAL
VITAL_XROAD_CLIENT=""       # ej. CO/GOB/CDMB-0271/GEOAMBIENTAL
VITAL_CLIENT_ID=""
VITAL_CLIENT_SECRET=""
VITAL_USERNAME=""
VITAL_PASSWORD=""
VITAL_TRAMITES="41"         # id_tramite(s) a sincronizar, coma-separado
