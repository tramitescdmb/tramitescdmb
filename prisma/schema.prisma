generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Configuración de apariencia (logos del header/footer institucional) — fila
// única "singleton", igual patrón que el proyecto Negocios Verdes
// (configuracion_sitio): logo propio + los 3 sellos oficiales de gov.co.
// ---------------------------------------------------------------------------

model ConfiguracionSitio {
  id               String   @id @default("singleton")
  logoUrl          String? // logo de la CDMB, header + footer
  logoPath         String?
  logoGovcoUrl     String? // franja azul superior
  logoGovcoPath    String?
  logoColombiaUrl  String? // franja azul del footer
  logoColombiaPath String?
  logoPotenciaUrl  String? // "Colombia Potencia de la Vida", franja del footer
  logoPotenciaPath String?
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Usuarios internos (funcionarios CDMB)
// ---------------------------------------------------------------------------

enum RolUsuario {
  ADMIN
  FUNCIONARIO
}

/**
 * Cargo real dentro de la CDMB (Subdirector SEYCA, Profesional en Derecho, etc.) —
 * es distinto del RolUsuario (que es el permiso dentro de la app). El cargo es
 * "quién es" el funcionario en la organización; se usa para resaltar qué pasos
 * de un trámite le corresponden. Catálogo fijo, sembrado en prisma/seed.ts a
 * partir de los "responsables" reales de los 30 procedimientos — ver
 * src/lib/cargos.ts para las palabras clave de coincidencia con cada paso.
 */
model Cargo {
  id                    String       @id @default(cuid())
  nombre                String       @unique
  orden                 Int          @default(0)
  usuarios              Usuario[]
  expedientesAsignacion Expediente[] @relation("ExpedienteCargosAsignados")
}

model Usuario {
  id           String     @id @default(cuid())
  email        String     @unique
  nombre       String
  passwordHash String
  rol          RolUsuario @default(FUNCIONARIO)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  // true = la identidad la valida el directorio activo de la CDMB (API externa,
  // src/lib/directorio-activo.ts). Estos usuarios NO tienen contraseña propia en
  // esta app: `passwordHash` queda con un valor centinela que nunca verifica, y
  // el formulario normal de correo/contraseña siempre los rechaza. Se dan de
  // alta solos la primera vez que inician sesión por directorio activo.
  directorioActivo Boolean @default(false)

  // Un funcionario puede tener varios cargos a la vez (ej. cubre dos puestos
  // en un área pequeña) — se usan TODOS para el resaltado/bloqueo por paso
  // (ver src/lib/cargos.ts), no solo el primero.
  cargos                Cargo[]
  tramitesAcceso        UsuarioTramiteAcceso[]
  seccionesAcceso       UsuarioSeccionAcceso[]
  expedientesCreados    Expediente[]           @relation("CreadoPor")
  expedientesAsignados  Expediente[]           @relation("ResponsableActual")
  expedientesAsignacion Expediente[]           @relation("ExpedienteUsuariosAsignados")
  documentos            ExpedienteDocumento[]
  eventos               ExpedienteEvento[]
  registrosAuditoria    RegistroAuditoria[]
  visitasTecnicas       VisitaTecnica[]

  // --- SGDEA / Correspondencia (ver bloque al final del archivo) ---
  // Dependencia (oficina) a la que pertenece el funcionario, y rol dentro del
  // módulo de correspondencia (null + no ADMIN = sin acceso al módulo).
  dependenciaId      String?
  rolCorrespondencia RolCorrespondencia?

  dependencia             Dependencia?            @relation("UsuarioDependencia", fields: [dependenciaId], references: [id])
  dependenciasResponsable Dependencia[]           @relation("DependenciaResponsable")
  comunicacionesRadicadas Comunicacion[]          @relation("ComunicacionRadicadaPor")
  comunicacionDocumentos  ComunicacionDocumento[] @relation("ComunicacionDocumentoSubidoPor")
  distribucionesRecibidas Distribucion[]          @relation("DistribucionUsuario")
  distribucionesAsignadas Distribucion[]          @relation("DistribucionAsignadoPor")
  firmas                  Firma[]                 @relation("FirmaUsuario")
  auditoriasDoc           AuditoriaDoc[]          @relation("AuditoriaDocUsuario")
  actasEliminacionAprobadas ActaEliminacion[]     @relation("ActaEliminacionAprobadaPor")

  @@index([dependenciaId])
}

// ---------------------------------------------------------------------------
// Acceso por trámite (admin-only, se configura desde /usuarios/[id]): a
// diferencia de Cargo (el puesto real, usado para resaltar/bloquear pasos por
// texto) y RolUsuario (Admin/Funcionario, permisos administrativos), esto
// controla, trámite por trámite del catálogo de "Trámites ambientales 2.0",
// si un funcionario puede solo VER o también EDITAR (crear/avanzar/subir
// documentos). Sin ninguna fila para un trámite dado, el funcionario NO lo ve
// (denegado por defecto) — el ADMIN siempre tiene acceso total, sin
// excepción. Reemplazó a un primer diseño con una tabla "Rol" reutilizable
// (nunca llegó a usarse):
// con pocos usuarios reales, asignar directo por persona es más simple y
// claro que crear roles intermedios. Ver src/lib/permisos.ts.
// ---------------------------------------------------------------------------

enum NivelAccesoTramite {
  VER
  EDITAR
}

model UsuarioTramiteAcceso {
  id            String             @id @default(cuid())
  usuarioId     String
  tramiteTipoId String
  nivel         NivelAccesoTramite

  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tramiteTipo TramiteTipo @relation(fields: [tramiteTipoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tramiteTipoId])
  @@index([tramiteTipoId])
}

// Acceso a las secciones de solo lectura VITAL y SINCA 1.0 — a diferencia de
// UsuarioTramiteAcceso no hay nivel (todo es consulta, nadie edita nada ahí),
// solo si puede entrar o no a cada pestaña. VITAL agrupa "Solicitudes" y
// "Recientes" en un solo permiso base (son la misma información, dos vistas)
// y dashboard aparte; SINCA 1.0 tiene Solicitudes (base), Dashboard y Minería
// de datos como tres permisos independientes — Minería de datos es la más
// sensible (pensada para directivos, no cualquier funcionario). Denegado por
// defecto, igual que UsuarioTramiteAcceso.
enum SeccionSoloLectura {
  VITAL_BASE
  VITAL_DASHBOARD
  SINCA_BASE
  SINCA_DASHBOARD
  SINCA_MINERIA
}

model UsuarioSeccionAcceso {
  id        String             @id @default(cuid())
  usuarioId String
  seccion   SeccionSoloLectura

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, seccion])
}

// ---------------------------------------------------------------------------
// Auditoría del sistema (distinta de ExpedienteEvento, que es la bitácora de
// UN expediente) — acciones a nivel de cuenta: logins, gestión de usuarios,
// cambios de configuración. Solo lectura desde /auditoria (solo ADMIN).
// ---------------------------------------------------------------------------

enum TipoAuditoria {
  LOGIN_EXITOSO
  LOGIN_FALLIDO
  USUARIO_CREADO
  USUARIO_ACTIVADO
  USUARIO_DESACTIVADO
  USUARIO_ACTUALIZADO
  CONFIGURACION_ACTUALIZADA
}

model RegistroAuditoria {
  id           String        @id @default(cuid())
  tipo         TipoAuditoria
  descripcion  String        @db.Text
  usuarioId    String? // quién hizo la acción; null si el login fallido no correspondía a ningún usuario real
  emailIntento String? // correo usado en un intento de login (exitoso o no), aunque no exista el usuario
  createdAt    DateTime      @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([tipo])
  @@index([usuarioId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// SINCA 1.0 — histórico de trámites ambientales con resolución de fondo.
// Espejo local (SOLO CONSULTA) del API externo `GET /api/presinca/resoluciones`
// (~5.163 registros al 2026-08). NADA en la app crea, edita ni borra estos
// datos desde la interfaz: se sincronizan desde el API con src/lib/sinca-sync.ts
// (backfill único + refresco diario) y solo se leen. `nroSolicitud` es el
// identificador que trae SINCA 1.0 (`nrosolicitud_sol`).
// ---------------------------------------------------------------------------

model SincaResolucion {
  nroSolicitud        Int       @id
  numeroResolucion    String?
  fechaResolucion     DateTime? // fecha_documento: fecha de la resolución de fondo
  anioResolucion      Int? // derivado de fechaResolucion, para agrupar sin castear en cada consulta
  fechaRecibido       DateTime? // fecharecibido_sol
  proyecto            String    @db.Text // proyecto_sol
  tipoSolicitud       String? // "(CA) CONCESIONES DE AGUAS" tal cual lo entrega el API
  tipoSolicitudCodigo String? // "CA" (derivado)
  tipoSolicitudNombre String? // "CONCESIONES DE AGUAS" (derivado)
  indTipoSolicitud    String? // indtiposol_sol.label — Normal / Renovación
  estado              String? // estado_sol.label — Aprobada, Negada, Desestimiento, ...
  origen              String? // origen_sol.label, si viene
  expediente          String? // expediente_sol
  departamento        String?
  municipio           String?
  barrio              String?
  correo              String? // correo_sol
  representanteLegal  String? // replegal_sol
  idRepresentante     String? // idreplegal_sol (NIT/cédula del representante)
  cantidadDocumentos  Int       @default(0) // cantidad_emision_documentos
  cantidadInteresados Int       @default(0) // cantidad_interesado
  lat                 Float?
  lon                 Float?

  // Campos que solo entrega el endpoint de detalle (GET /presinca/resoluciones/{n}),
  // no el listado. Se llenan con el paso de enriquecimiento (src/lib/sinca-sync.ts).
  diasResolucion    Int? // fechaResolucion - fechaRecibido, en días (tiempo de trámite)
  solicitanteNit    String? // interesado[0].nit.numero_nit
  solicitanteNombre String? // razón social o nombre del interesado
  enriquecidoEn     DateTime? // null = falta traer el detalle

  raw            Json // registro original completo del API (para la ficha de detalle)
  sincronizadoEn DateTime @default(now())

  @@index([anioResolucion])
  @@index([tipoSolicitudCodigo])
  @@index([estado])
  @@index([municipio])
  @@index([expediente])
  @@index([fechaResolucion])
  @@index([diasResolucion])
  @@index([solicitanteNit])
  @@index([enriquecidoEn])
}

model SincaSincronizacion {
  id           String    @id @default(cuid())
  iniciadoEn   DateTime  @default(now())
  terminadoEn  DateTime?
  ok           Boolean   @default(false)
  totalApi     Int?
  creados      Int?
  actualizados Int?
  eliminados   Int?
  mensajeError String?   @db.Text
  disparadoPor String? // "cron", "manual:<usuario>", "script"
}

/// Fila única (id fijo) con el registro completo de NIT/terceros de SINCA 1.0 ya agrupado por
/// tercero — recalcularlo recorre las ~33 mil filas del API (~20s), así que se guarda aquí en
/// vez de con unstable_cache: el payload agrupado pesa más de los 2MB que esa caché admite.
model SincaNitSnapshot {
  id          String   @id @default("actual")
  datos       Json
  calculadoEn DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Catálogo de trámites (datos de referencia, sembrados desde data/tramites/*.json)
// ---------------------------------------------------------------------------

model TramiteTipo {
  id                       String   @id @default(cuid())
  codigo                   String   @unique // ej. M-DA-PR05
  version                  String
  fecha                    DateTime
  proceso                  String
  nombre                   String
  nombreCompleto           String
  slug                     String   @unique
  archivoFuente            String
  objeto                   String   @db.Text
  resumen                  String?  @db.Text // frase natural "Este trámite..." para la UI (objeto es la redacción formal del PDF)
  alcance                  String   @db.Text
  autoridadResponsabilidad String   @db.Text
  suitNumeros              String[] @default([]) // número(s) de ficha en el SUIT (Sistema Único de Información de Trámites), si está inscrito — algunos trámites tienen más de uno (ej. concesión de aguas superficiales + subterráneas por separado)
  activo                   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  flujos               Flujo[]
  documentosRequeridos DocumentoRequeridoDefinicion[]
  expedientes          Expediente[]
  usuariosConAcceso    UsuarioTramiteAcceso[]
}

model DocumentoRequeridoDefinicion {
  id            String           @id @default(cuid())
  tramiteTipoId String
  orden         Int
  nombre        String
  obligatorio   Boolean          @default(true)
  notas         String?
  aplicaA       TipoSolicitante? // null = aplica a cualquier solicitante; si no, solo es obligatorio para ese tipo (ej. "Certificado de Existencia y Representación Legal" solo para JURIDICA)

  tramiteTipo TramiteTipo @relation(fields: [tramiteTipoId], references: [id], onDelete: Cascade)

  @@index([tramiteTipoId])
}

model Flujo {
  id             String  @id @default(cuid())
  tramiteTipoId  String
  codigo         String // inicio | renovacion | ...
  nombre         String
  esFlujoInicial Boolean @default(false)
  orden          Int     @default(0)
  suitNumero     String? // ficha del SUIT específica de ESTE flujo, cuando el SUIT registra cada modalidad por separado (ej. M-DA-PR21: "Concesión de Aguas Superficiales" y "Concesión de Aguas Subterráneas" son un solo procedimiento/PDF pero dos fichas SUIT distintas)
  resumen        String? @db.Text // frase natural de ESTE flujo, para cuando se ve enfocado en un solo flujo (?flujo=...) y no debe mencionar la otra modalidad

  tramiteTipo TramiteTipo      @relation(fields: [tramiteTipoId], references: [id], onDelete: Cascade)
  pasos       PasoDefinicion[]
  expedientes Expediente[]

  @@unique([tramiteTipoId, codigo])
}

model PasoDefinicion {
  id           String   @id @default(cuid())
  flujoId      String
  numero       Int
  titulo       String
  descripcion  String   @db.Text
  responsables String[]
  documentos   String[]
  tiempo       String?
  tiempoDias   Int?
  esDecision   Boolean  @default(false)
  opciones     Json?

  flujo Flujo @relation(fields: [flujoId], references: [id], onDelete: Cascade)

  @@unique([flujoId, numero])
}

// ---------------------------------------------------------------------------
// Expedientes (instancias reales de un trámite gestionadas por la CDMB)
// ---------------------------------------------------------------------------

enum EstadoExpediente {
  RADICADO
  EN_TRAMITE
  INFORMACION_ADICIONAL_REQUERIDA
  SUSPENDIDO
  APROBADO
  NEGADO
  DESISTIDO
  ARCHIVADO
  RECHAZADO
}

enum TipoSolicitante {
  NATURAL
  JURIDICA
}

enum RegimenTributario {
  RESPONSABLE_IVA
  NO_RESPONSABLE_IVA
  SIMPLE_TRIBUTACION
  REGIMEN_ESPECIAL
  OTRO
}

enum ClaseSolicitud {
  NUEVA
  RENOVACION
}

/**
 * Registro maestro por NIT/cédula — antes cada Expediente guardaba su propia
 * copia de los datos del solicitante, sin nada que los conectara: la misma
 * empresa podía quedar escrita distinto en cada trámite, y no había forma de
 * preguntar "¿qué otros trámites tiene esta NIT con la CDMB?". Ahora, al
 * radicar, se busca por identificación — si ya existe se reutiliza (y se
 * actualizan los datos de contacto), si no existe se crea aquí.
 * El régimen tributario y "gran contribuyente" NO son decorativos: la CDMB
 * a veces le paga a estos mismos terceros (o cobra estampillas), y el
 * régimen determina retenciones/beneficios — por eso se guardan aquí y no
 * en cada Expediente. A propósito no se replicó el formulario contable
 * completo del sistema viejo (clave contable, RUP, actividad económica...)
 * — eso vive en el sistema contable real de la CDMB, no en SINCA.
 * `Expediente.solicitanteNombre/Identificacion/...` se mantienen aparte
 * (no se borran): son la foto de cómo era el solicitante EN ESE MOMENTO,
 * que para un trámite regulatorio es lo correcto conservar aunque el
 * tercero cambie de nombre o dirección después.
 */
model Solicitante {
  id                String             @id @default(cuid())
  tipo              TipoSolicitante
  identificacion    String             @unique // NIT o cédula, tal como se escribe (ej. "900123456-1")
  // Separados para poder buscar por nombre o por apellido (persona natural) — para persona
  // jurídica normalmente solo aplica razonSocial, pero se deja nombres/apellidos libres por si
  // hace falta guardar el nombre de un contacto/representante. Validado en la app según `tipo`,
  // no aquí, porque cuál es obligatorio depende del tipo.
  nombres           String?
  apellidos         String?
  razonSocial       String?
  regimenTributario RegimenTributario?
  granContribuyente Boolean            @default(false)
  email             String?
  telefono          String?
  direccion         String?
  municipio         String // obligatorio — incluye "Fuera de la jurisdicción" como opción válida explícita, ver src/lib/municipios.ts
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  expedientes    Expediente[]
  comunicaciones Comunicacion[] // como remitente/destinatario en el módulo de correspondencia
}

model Expediente {
  id            String @id @default(cuid())
  numero        String @unique // ej. M-DA-PR05-2026-0001
  tramiteTipoId String
  flujoId       String

  solicitanteId             String? // vínculo al registro maestro por NIT/cédula (ver Solicitante) — null en expedientes creados antes de este campo
  solicitanteTipo           TipoSolicitante @default(NATURAL)
  solicitanteNombre         String
  solicitanteIdentificacion String
  solicitanteEmail          String?
  solicitanteTelefono       String?
  solicitanteDireccion      String? // dirección del solicitante — distinta de la del predio (ej. empresa con sede en otra ciudad)
  predioDireccion           String? // dirección del predio o del lugar donde se desarrolla el proyecto
  municipio                 String // uno de los 13 municipios de la jurisdicción CDMB (ver src/lib/municipios.ts)

  claseSolicitud ClaseSolicitud? // Nueva / Renovación — el PDF del procedimiento no siempre lo distingue como flujo aparte

  // Datos del predio que el procedimiento oficial no siempre pide como tal, pero que sí importan
  // para la decisión real (ej. el área determina cuánta agua se puede conceder) o son identificadores
  // legales reales del predio — no están todos los trámites, por eso opcionales.
  predioNombre         String? // ej. "Finca La Esperanza" — un predio rural casi siempre tiene nombre propio, distinto de la dirección
  predioCatastral      String? // número catastral (IGAC)
  predioMatricula      String? // matrícula inmobiliaria
  predioAreaM2         Float?
  predioAreaCultivosM2 Float?
  predioAreaBosqueM2   Float?
  predioViviendas      Int?

  // Ubicación del predio/proyecto tomada en campo (mapa OSM) — opcional, no todo trámite la necesita.
  // Se puede cargar desde cualquiera de las 3 representaciones (elipsoidal/plana/cartesiana);
  // lat/lon (WGS84) es la que manda internamente, las demás se recalculan siempre en el
  // servidor a partir de ella — ver src/lib/coordenadas.ts. Sin altura: se probó y se quitó
  // a pedido del usuario (no la necesitan para nada de este trámite).
  ubicacionLat         Float? // elipsoidal WGS84
  ubicacionLon         Float? // elipsoidal WGS84
  ubicacionPlanaX      Float? // MAGNA-SIRGAS Origen-Nacional (EPSG:9377)
  ubicacionPlanaY      Float?
  ubicacionCartesianaX Float? // ECEF geocéntrica (mismo elipsoide GRS80)
  ubicacionCartesianaY Float?
  ubicacionCartesianaZ Float?

  // Dirección/ubicación del SOLICITANTE — distinta de la del predio/proyecto de arriba (ej.
  // una empresa con sede en Bucaramanga que solicita un permiso para un proyecto en Vetas).
  // Mismo esquema, misma lógica de recálculo en el servidor.
  solicitanteUbicacionLat         Float?
  solicitanteUbicacionLon         Float?
  solicitanteUbicacionPlanaX      Float?
  solicitanteUbicacionPlanaY      Float?
  solicitanteUbicacionCartesianaX Float?
  solicitanteUbicacionCartesianaY Float?
  solicitanteUbicacionCartesianaZ Float?

  estado           EstadoExpediente @default(RADICADO)
  pasoActualNumero Int              @default(1)

  createdById         String
  responsableActualId String?

  fechaRadicacion       DateTime @default(now())
  fechaUltimoMovimiento DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tramiteTipo       TramiteTipo  @relation(fields: [tramiteTipoId], references: [id])
  flujo             Flujo        @relation(fields: [flujoId], references: [id])
  creadoPor         Usuario      @relation("CreadoPor", fields: [createdById], references: [id])
  responsableActual Usuario?     @relation("ResponsableActual", fields: [responsableActualId], references: [id])
  solicitante       Solicitante? @relation(fields: [solicitanteId], references: [id])

  documentos      ExpedienteDocumento[]
  eventos         ExpedienteEvento[]
  visitasTecnicas VisitaTecnica[]

  /**
   * Asignación del expediente completo (distinta de `responsableActual`, que
   * es solo "quién lo tiene ahora mismo" y cambia a medida que avanza de
   * paso). Esto es "quién(es) deben trabajar este expediente" — a uno o
   * varios usuarios puntuales, y/o a uno o varios cargos (cualquiera que
   * tenga ese cargo). Por ahora es solo informativo/visible: no bloquea a
   * nadie más para editar el expediente (decisión explícita del usuario —
   * convertir esto en una restricción real de permisos es un cambio
   * aparte, a confirmar antes de hacerlo).
   */
  usuariosAsignados Usuario[] @relation("ExpedienteUsuariosAsignados")
  cargosAsignados   Cargo[]   @relation("ExpedienteCargosAsignados")

  // Comunicaciones (correspondencia/memorandos) archivadas dentro de este expediente — unificación SGDEA.
  comunicaciones Comunicacion[]

  @@index([tramiteTipoId])
  @@index([estado])
  @@index([municipio])
  @@index([solicitanteId])
}

model ExpedienteDocumento {
  id           String   @id @default(cuid())
  expedienteId String
  pasoNumero   Int?
  nombre       String
  descripcion  String?
  storagePath  String
  mimeType     String
  tamanoBytes  Int
  subidoPorId  String
  createdAt    DateTime @default(now())

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  subidoPor  Usuario    @relation(fields: [subidoPorId], references: [id])

  @@index([expedienteId])
}

enum TipoEvento {
  CREACION
  CAMBIO_ESTADO
  AVANCE_PASO
  DOCUMENTO_SUBIDO
  DOCUMENTO_ELIMINADO
  COMENTARIO
  ASIGNACION_CAMBIADA
  VISITA_REGISTRADA
}

model ExpedienteEvento {
  id             String            @id @default(cuid())
  expedienteId   String
  tipo           TipoEvento
  descripcion    String            @db.Text
  pasoNumero     Int?
  estadoAnterior EstadoExpediente?
  estadoNuevo    EstadoExpediente?
  usuarioId      String
  createdAt      DateTime          @default(now())

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])

  @@index([expedienteId])
}

/**
 * Punto de geoposición capturado en campo por un funcionario de la CDMB (ej. durante la "visita
 * técnica" que exige la mayoría de los procedimientos — ver la descripción del paso en
 * data/tramites/*.json, que literalmente pide "geo-referenciación del predio... registrando los
 * datos en el SINCA"). A diferencia de los campos ubicacion.../solicitanteUbicacion... de Expediente
 * (capturados una vez al radicar, por dirección o a mano desde un mapa), esto se captura desde el GPS real del
 * dispositivo del funcionario (navigator.geolocation) durante cualquier paso posterior — puede haber
 * más de uno por expediente si hay varias visitas en distintos pasos. No está atado a un trámite en
 * particular: la "visita técnica" es común a la mayoría, así que el botón de captura está siempre
 * disponible en el paso actual, y cada funcionario lo usa si corresponde a su procedimiento.
 */
model VisitaTecnica {
  id             String   @id @default(cuid())
  expedienteId   String
  pasoNumero     Int
  lat            Float
  lon            Float
  planaX         Float?
  planaY         Float?
  cartesianaX    Float?
  cartesianaY    Float?
  cartesianaZ    Float?
  precisionM     Float? // exactitud reportada por el GPS del dispositivo (navigator.geolocation) — informativa, no se valida
  nota           String?  @db.Text
  capturadoPorId String
  createdAt      DateTime @default(now())

  expediente   Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  capturadoPor Usuario    @relation(fields: [capturadoPorId], references: [id])

  @@index([expedienteId])
}

// ---------------------------------------------------------------------------
// Integración VITAL/OTIC (MinAmbiente) — espejo de solo lectura de las
// solicitudes que el ciudadano radica en la Ventanilla Integral de Trámites
// Ambientales en Línea (VITAL), traídas vía los servicios web expuestos por
// X-ROAD (ver src/lib/vital.ts). Por ahora es de un solo sentido: se
// sincroniza PARA VER, no se reporta nada de vuelta a VITAL (eso — avance de
// actividad, asociación de radicado — quedó explícitamente fuera de alcance).
// ---------------------------------------------------------------------------

model SolicitudVital {
  id                 String    @id @default(cuid())
  idVital            String    @unique // número VITAL de la solicitud (idVital)
  idTramiteVital     Int // id_tramite en VITAL
  idTramiteAutoridad Int? // idTramiteAutoridad — identificador propio de la CDMB en VITAL, si aplica
  fechaRadicacion    DateTime?
  nombreActividad    String? // última actividad conocida al momento de sincronizar (hu-otic-vital-io-001)

  solicitanteNombre         String?
  solicitanteIdentificacion String?
  solicitanteCorreo         String?
  solicitanteRaw            Json? // respuesta completa de hu-otic-vital-io-003, tal cual (persona natural o jurídica)
  camposTramite             Json? // respuesta completa de hu-otic-vital-io-002, tal cual (campos del formulario)

  // Cuántos documentos reportó wsDocumentos en la última sincronización — puede ser mayor que
  // `documentos.length` si la descarga falló (confirmado en vivo: el servicio /descargar de VITAL
  // devuelve 403 "sin permisos" para TODA descarga hasta ahora, aunque wsDocumentos sí lista los
  // archivos). Null = todavía no se sincronizó con esta columna. Sirve para poder avisar en el
  // detalle que hay un adjunto que VITAL reporta pero no se pudo traer, en vez de mostrar "sin
  // documentos" como si el trámite realmente no tuviera ninguno.
  documentosReportados Int?

  documentos           SolicitudVitalDocumento[]
  ultimaSincronizacion DateTime                  @default(now()) @updatedAt
  createdAt            DateTime                  @default(now())

  @@index([idTramiteVital])
}

/**
 * Trámites de VITAL que la CDMB puede consultar. VITAL no expone un catálogo, así
 * que la lista se descubre: `NOMBRE_TRAMITE_VITAL` (src/lib/vital.ts) trae los
 * conocidos, y el cron va probando ids nuevos con `wsObtenerSolicitudes` — si
 * alguno responde con solicitudes se agrega aquí y se empieza a sincronizar.
 */
model VitalTramite {
  idTramite      Int       @id
  nombre         String?
  activo         Boolean   @default(true)
  detectadoEn    DateTime  @default(now())
  ultimaRevision DateTime?
  ultimoConteo   Int?
}

/**
 * Cursor de la exploración de ids de trámite (fila única).
 */
model VitalDescubrimiento {
  id            String   @id @default("singleton")
  proximoId     Int      @default(1)
  actualizadoEn DateTime @updatedAt
}

model SolicitudVitalDocumento {
  id          String   @id @default(cuid())
  solicitudId String
  nombre      String
  storagePath String // ya descargado del link temporal de VITAL (expira en 1h) y re-subido a nuestro Storage
  mimeType    String
  tamanoBytes Int
  createdAt   DateTime @default(now())

  solicitud SolicitudVital @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@index([solicitudId])
}

// ===========================================================================
// SGDEA — Sistema de Gestión de Documentos Electrónicos de Archivo
// (Correspondencia y gestión documental, conforme al marco del AGN:
//  Ley 594/2000, Acuerdo 060/2001, Acuerdos 03/2015 y 01/2024, MoReq).
// Fase 1: núcleo archivístico + ventanilla de correspondencia RECIBIDA.
// Ver plan y memoria reference-oracle-legacy-cdmb (sistema COR que reemplaza).
// ===========================================================================

// Rol del funcionario DENTRO del módulo de correspondencia (independiente de
// RolUsuario/Cargo). null + no ADMIN = sin acceso al módulo (denegado por
// defecto, mismo criterio que UsuarioTramiteAcceso/UsuarioSeccionAcceso).
enum RolCorrespondencia {
  OPERADOR_VENTANILLA // radica y reparte en la ventanilla única
  FUNCIONARIO_DEPENDENCIA // recibe y responde lo distribuido a su dependencia
  JEFE_DEPENDENCIA // además reparte dentro de su dependencia
  ADMIN_ARCHIVO // administra TRD/CCD, dependencias y ve todo
}

// Disposición final de una subserie documental (TRD) — Acuerdo 004/2019 AGN.
enum DisposicionFinal {
  CONSERVACION_TOTAL
  ELIMINACION
  SELECCION
  MICROFILMACION_DIGITALIZACION
}

enum TipoComunicacion {
  RECIBIDA // entra a la entidad
  ENVIADA // sale de la entidad (Fase 2)
  INTERNA // memorando entre dependencias (Fase 2)
}

enum EstadoComunicacion {
  RADICADA // recién radicada en ventanilla
  EN_REPARTO // pendiente de distribuir
  ASIGNADA // distribuida a dependencia/funcionario
  EN_TRAMITE // en gestión
  INFORMACION_ADICIONAL_REQUERIDA // término de ley suspendido (Art. 17 CPACA) hasta que el peticionario responda
  RESPONDIDA
  ARCHIVADA
  ANULADA // anulada con justificación (no se borra: queda trazada)
}

enum OrigenComunicacion {
  VENTANILLA // radicada por un operador
  WEB_PQRSD // formulario público (Fase 3)
  MIGRACION_COR // importada del Oracle legado (Fase 4)
  CORREO_ELECTRONICO
  OTRO
}

// Clasificación PQRSD (Ley 1755/2015, que modificó el Título II del CPACA — Ley
// 1437/2011). El término de respuesta depende del tipo, no es uniforme.
enum TipoPQRSD {
  PETICION_GENERAL // interés general o particular — 15 días hábiles
  PETICION_DOCUMENTOS // copia/consulta de documentos — 10 días hábiles
  CONSULTA // 30 días hábiles
  QUEJA // 15 días hábiles
  RECLAMO // 15 días hábiles
  SUGERENCIA // 15 días hábiles
  DENUNCIA // 15 días hábiles (puede derivar a control interno disciplinario)
}

enum MedioComunicacion {
  FISICO
  CORREO_ELECTRONICO
  WEB
  FAX
  PRESENCIAL
  TELEFONICO
  OTRO
}

// Acciones registradas en la bitácora inalterable (incluye LEE y EXPORTA, que
// la auditoría de cuenta RegistroAuditoria no captura).
enum AccionAuditoriaDoc {
  CREA
  LEE
  MODIFICA
  EXPORTA
  ELIMINA
  DISTRIBUYE
  FIRMA
  CLASIFICA
  ARCHIVA
  ANULA
  SUSPENDE // suspende el término de ley (Art. 17 CPACA)
  REACTIVA
  TRANSFIERE // pasa del archivo de gestión al archivo central
  DISPONE // ejecuta la disposición final (conserva/elimina/selecciona/microfilma)
}

// Organigrama de la CDMB (dependencias/oficinas). Jerárquico vía parentId.
// Fase 1 se siembra con una estructura mínima derivada de los cargos reales,
// editable desde el admin.
model Dependencia {
  id                   String   @id @default(cuid())
  codigo               String   @unique
  nombre               String
  parentId             String?
  nivel                Int      @default(0)
  responsableUsuarioId String?
  activo               Boolean  @default(true)
  orden                Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  parent      Dependencia?      @relation("DependenciaJerarquia", fields: [parentId], references: [id])
  hijos       Dependencia[]     @relation("DependenciaJerarquia")
  responsable Usuario?          @relation("DependenciaResponsable", fields: [responsableUsuarioId], references: [id])
  usuarios    Usuario[]         @relation("UsuarioDependencia")
  series      SerieDocumental[]

  comunicacionesDestino Comunicacion[] @relation("ComunicacionDependenciaDestino")
  comunicacionesOrigen  Comunicacion[] @relation("ComunicacionDependenciaOrigen")
  distribuciones        Distribucion[]

  @@index([parentId])
}

// Serie documental (TRD/CCD). Versionada: se pueden tener la TRD anterior y la
// nueva a la vez (vigenteDesde/Hasta) para migrar clasificaciones entre versiones.
model SerieDocumental {
  id            String    @id @default(cuid())
  codigo        String
  nombre        String
  dependenciaId String?
  version       String    @default("1")
  vigenteDesde  DateTime  @default(now())
  vigenteHasta  DateTime?
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  dependencia    Dependencia?         @relation(fields: [dependenciaId], references: [id])
  subseries      SubserieDocumental[]
  comunicaciones Comunicacion[]

  @@unique([codigo, version])
  @@index([dependenciaId])
}

model SubserieDocumental {
  id                    String            @id @default(cuid())
  serieId               String
  codigo                String
  nombre                String
  retencionGestionAnios Int               @default(0)
  retencionCentralAnios Int               @default(0)
  disposicionFinal      DisposicionFinal?
  procedimiento         String?           @db.Text
  activo                Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  serie          SerieDocumental @relation(fields: [serieId], references: [id], onDelete: Cascade)
  comunicaciones Comunicacion[]

  @@unique([serieId, codigo])
  @@index([serieId])
}

// Secuencia de radicación ATÓMICA e inalterable — una fila por (serie, año).
// El consecutivo se obtiene con un UPDATE ... { increment: 1 } sobre esta fila
// (row-lock), NO con un COUNT(*) como en src/lib/expedientes.ts (que es
// race-prone). Ver src/lib/radicado.ts.
model ConsecutivoRadicado {
  id           String   @id @default(cuid())
  serie        String // "R" recibida, "E" enviada, "I" interna
  anio         Int
  ultimoNumero Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([serie, anio])
}

// Comunicación oficial radicada. Fase 1 usa tipo RECIBIDA; ENVIADA/INTERNA en Fase 2.
model Comunicacion {
  id              String             @id @default(cuid())
  tipo            TipoComunicacion
  radicado        String             @unique // ej. CDMB-R-2026-000123
  anio            Int
  fechaRadicacion DateTime           @default(now())
  medio           MedioComunicacion?
  origen          OrigenComunicacion @default(VENTANILLA)
  estado          EstadoComunicacion @default(RADICADA)

  asunto            String  @db.Text
  contenido         String? @db.Text // cuerpo del oficio/memorando (ENVIADA/INTERNA); en RECIBIDA solo se usa para la narración de una PQRSD (el resto llega como documento adjunto)
  folios            Int     @default(1)
  anexosDescripcion String?

  // PQRSD (Fase 3, Ley 1755/2015): solo aplica a RECIBIDA. `terminoDiasHabiles`
  // queda fijado al radicar (según el tipo) para poder recalcular el vencimiento
  // si el término se suspende y se reactiva (Art. 17 CPACA) sin tener que volver
  // a mirar la tabla de términos por tipo más adelante.
  tipoPqrsd              TipoPQRSD?
  terminoDiasHabiles     Int?
  fechaSuspensionTermino DateTime?

  // Tercero (remitente si RECIBIDA / destinatario si ENVIADA): FK opcional al
  // maestro Solicitante + snapshot "foto del momento" (mismo patrón que Expediente).
  terceroId                 String?
  terceroTipo               TipoSolicitante?
  terceroTipoIdentificacion String? // CC, CE, NIT, PA, TI, ANONIMO (texto libre; no hay enum de tipo-id en el proyecto)
  terceroIdentificacion     String?
  terceroNombre             String?
  terceroEmail              String?
  terceroTelefono           String?
  terceroDireccion          String?
  terceroMunicipio          String?

  dependenciaOrigenId  String? // quién envía (ENVIADA/INTERNA) — la dependencia que redacta
  dependenciaDestinoId String? // a qué dependencia de la CDMB va dirigida (RECIBIDA) o destino (INTERNA)
  serieId              String? // clasificación TRD
  subserieId           String?
  expedienteId         String? // archivada dentro de un expediente (unificación)
  vitalRelacionado     String? // idVital relacionado, si aplica (columna VITAL_REC del legado)
  respondeAId          String? // ENVIADA que responde a una comunicación RECIBIDA — enlaza el ciclo completo

  fechaVencimiento DateTime? // término de ley (se calcula en Fase 3 con días hábiles)
  radicadoPorId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Disposición final (Fase 4, Acuerdo 004/2019 AGN): retención contada desde
  // fechaRadicacion usando retencionGestionAnios/retencionCentralAnios de la
  // subserie. La eliminación/selección exige un acta (ActaEliminacion); la
  // conservación total/microfilmación no destruyen nada en este sistema, solo
  // marcan fechaDisposicionFinal.
  transferidaCentralEn  DateTime?
  fechaDisposicionFinal DateTime?
  actaEliminacionId     String?

  tercero            Solicitante?        @relation(fields: [terceroId], references: [id])
  dependenciaOrigen  Dependencia?        @relation("ComunicacionDependenciaOrigen", fields: [dependenciaOrigenId], references: [id])
  dependenciaDestino Dependencia?        @relation("ComunicacionDependenciaDestino", fields: [dependenciaDestinoId], references: [id])
  serie              SerieDocumental?    @relation(fields: [serieId], references: [id])
  subserie           SubserieDocumental? @relation(fields: [subserieId], references: [id])
  expediente         Expediente?         @relation(fields: [expedienteId], references: [id])
  radicadoPor        Usuario?            @relation("ComunicacionRadicadaPor", fields: [radicadoPorId], references: [id])
  respondeA          Comunicacion?       @relation("ComunicacionRespuesta", fields: [respondeAId], references: [id])
  respuestas         Comunicacion[]      @relation("ComunicacionRespuesta")
  actaEliminacion    ActaEliminacion?    @relation(fields: [actaEliminacionId], references: [id])

  documentos     ComunicacionDocumento[]
  distribuciones Distribucion[]
  firmas         Firma[]

  @@index([tipo])
  @@index([anio])
  @@index([dependenciaOrigenId])
  @@index([respondeAId])
  @@index([estado])
  @@index([fechaRadicacion])
  @@index([dependenciaDestinoId])
  @@index([expedienteId])
  @@index([fechaVencimiento])
  @@index([actaEliminacionId])
}

// Acta formal que autoriza eliminar o seleccionar (eliminación parcial) un lote de
// comunicaciones ya vencidas en su retención (Acuerdo 004/2019 AGN). El original se
// destruye, pero el registro del sistema (radicado, asunto, fechas) se conserva
// como evidencia de qué existió y bajo qué autorización se dispuso — nunca se borra
// la fila de Comunicacion en sí.
model ActaEliminacion {
  id            String   @id @default(cuid())
  numero        Int      @unique @default(autoincrement())
  fecha         DateTime @default(now())
  responsable   String // nombre de quien aprueba (comité de archivo), texto libre
  motivacion    String?  @db.Text
  aprobadaPorId String?
  createdAt     DateTime @default(now())

  aprobadaPor    Usuario?       @relation("ActaEliminacionAprobadaPor", fields: [aprobadaPorId], references: [id])
  comunicaciones Comunicacion[]

  @@index([fecha])
}

// Adjunto de una comunicación. Igual patrón que ExpedienteDocumento + hash
// SHA-256 del contenido (integridad/preservación, MoReq).
model ComunicacionDocumento {
  id             String   @id @default(cuid())
  comunicacionId String
  nombre         String
  descripcion    String?
  storagePath    String
  mimeType       String
  tamanoBytes    Int
  hashSha256     String? // integridad del archivo tal como se recibió
  subidoPorId    String?
  createdAt      DateTime @default(now())

  comunicacion Comunicacion @relation(fields: [comunicacionId], references: [id], onDelete: Cascade)
  subidoPor    Usuario?     @relation("ComunicacionDocumentoSubidoPor", fields: [subidoPorId], references: [id])

  @@index([comunicacionId])
}

// Distribución/reparto de una comunicación a una dependencia y/o funcionario.
model Distribucion {
  id              String    @id @default(cuid())
  comunicacionId  String
  dependenciaId   String?
  usuarioId       String?
  instrucciones   String?   @db.Text
  termino         Int? // días para responder (se convierte a fechaVencimiento en Fase 3)
  fechaAsignacion DateTime  @default(now())
  fechaAcuse      DateTime? // cuándo el destinatario dio acuse de recibido
  asignadoPorId   String?
  createdAt       DateTime  @default(now())

  comunicacion Comunicacion @relation(fields: [comunicacionId], references: [id], onDelete: Cascade)
  dependencia  Dependencia? @relation(fields: [dependenciaId], references: [id])
  usuario      Usuario?     @relation("DistribucionUsuario", fields: [usuarioId], references: [id])
  asignadoPor  Usuario?     @relation("DistribucionAsignadoPor", fields: [asignadoPorId], references: [id])

  @@index([comunicacionId])
  @@index([dependenciaId])
  @@index([usuarioId])
}

// Firma electrónica con hash (Ley 527/1999 + Decreto 2364/2012): identidad del
// firmante + marca de tiempo + hash SHA-256 del contenido firmado. No es firma
// digital con certificado de CA. Usada en Fase 2 (salientes/memorandos).
model Firma {
  id             String   @id @default(cuid())
  usuarioId      String
  fechaHora      DateTime @default(now())
  hashContenido  String
  tipo           String   @default("ELECTRONICA_HASH")
  comunicacionId String?
  documentoId    String?
  ip             String?

  usuario      Usuario       @relation("FirmaUsuario", fields: [usuarioId], references: [id])
  comunicacion Comunicacion? @relation(fields: [comunicacionId], references: [id])

  @@index([comunicacionId])
  @@index([usuarioId])
}

// Bitácora inalterable con cadena de hash. Cada fila encadena su `hash` con el
// `hashAnterior` (hash de la fila previa por `secuencia`): alterar/borrar una
// fila rompe la cadena y `verificarCadena()` lo detecta. Registra también LEE y
// EXPORTA. Ver src/lib/auditoria-doc.ts.
model AuditoriaDoc {
  id           String             @id @default(cuid())
  secuencia    Int                @unique @default(autoincrement())
  entidad      String // "Comunicacion", "ComunicacionDocumento", ...
  entidadId    String
  accion       AccionAuditoriaDoc
  usuarioId    String?
  ip           String?
  userAgent    String?
  detalle      String?            @db.Text
  hashAnterior String?
  hash         String
  createdAt    DateTime           @default(now())

  usuario Usuario? @relation("AuditoriaDocUsuario", fields: [usuarioId], references: [id])

  @@index([entidad, entidadId])
  @@index([usuarioId])
  @@index([createdAt])
}

// Límite de envíos públicos sin autenticación (formulario PQRSD, Fase 3). No hay
// CAPTCHA de terceros en el proyecto (exigiría una cuenta/API key externa) — este
// conteo por IP+ruta, combinado con honeypot y tiempo mínimo de llenado en el
// propio formulario, es la defensa contra abuso. Persistido en base (no en
// memoria): en Vercel cada invocación puede caer en una instancia distinta.
model IntentoEnvioPublico {
  id        String   @id @default(cuid())
  ip        String
  ruta      String
  createdAt DateTime @default(now())

  @@index([ip, ruta, createdAt])
}
