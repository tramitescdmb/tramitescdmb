  posX           Float?
  posY           Float?

  flujo             FlujoTrabajo     @relation(fields: [flujoId], references: [id], onDelete: Cascade)
  dependencia       Dependencia?     @relation("PasoFlujoDependencia", fields: [dependenciaId], references: [id])
  transiciones      TransicionPaso[] @relation("TransicionDesde")
  transicionesHacia TransicionPaso[] @relation("TransicionHacia")
  instanciasAqui    InstanciaFlujo[] @relation("InstanciaPasoActual")
  ejecuciones       PasoEjecutado[]

  @@index([flujoId])
}

model TransicionPaso {
  id          String @id @default(cuid())
  flujoId     String
  desdePasoId String
  haciaPasoId String
  etiqueta    String @default("Continuar")
  orden       Int    @default(0)

  flujo FlujoTrabajo @relation(fields: [flujoId], references: [id], onDelete: Cascade)
  desde PasoFlujo    @relation("TransicionDesde", fields: [desdePasoId], references: [id], onDelete: Cascade)
  hacia PasoFlujo    @relation("TransicionHacia", fields: [haciaPasoId], references: [id], onDelete: Cascade)

  @@index([flujoId])
  @@index([desdePasoId])
}

model InstanciaFlujo {
  id              String               @id @default(cuid())
  flujoId         String
  comunicacionId  String
  estado          EstadoInstanciaFlujo @default(EN_CURSO)
  pasoActualId    String?
  pasoActualDesde DateTime?
  iniciadoPorId   String?
  iniciadoEn      DateTime             @default(now())
  finalizadoEn    DateTime?

  flujo        FlujoTrabajo    @relation(fields: [flujoId], references: [id])
  comunicacion Comunicacion    @relation(fields: [comunicacionId], references: [id], onDelete: Cascade)
  pasoActual   PasoFlujo?      @relation("InstanciaPasoActual", fields: [pasoActualId], references: [id])
  iniciadoPor  Usuario?        @relation("InstanciaFlujoIniciadoPor", fields: [iniciadoPorId], references: [id])
  ejecuciones  PasoEjecutado[]

  @@index([comunicacionId])
  @@index([estado])
}

model PasoEjecutado {
  id            String   @id @default(cuid())
  instanciaId   String
  pasoId        String
  resultado     String?
  comentario    String?  @db.Text
  responsableId String?
  completadoEn  DateTime @default(now())

  instancia   InstanciaFlujo @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  paso        PasoFlujo      @relation(fields: [pasoId], references: [id])
  responsable Usuario?       @relation("PasoEjecutadoResponsable", fields: [responsableId], references: [id])

  @@index([instanciaId])
}

enum RolContratacion {
  ADMINISTRADOR_CONTRATACION
  JEFE_CONTRATACION
  FUNCIONARIO_CONTRATACION
  JEFE_DEPENDENCIA
  SUPERVISOR_INTERVENTOR
  CONTRATISTA
}

enum EtapaContratacion {
  PRECONTRACTUAL
  CONTRACTUAL
  POSTCONTRACTUAL
}

enum ModalidadSeleccion {
  LICITACION_PUBLICA
  SELECCION_ABREVIADA_MENOR_CUANTIA
  SELECCION_ABREVIADA_SUBASTA_INVERSA
  SELECCION_ABREVIADA_ENAJENACION_BIENES
  CONCURSO_MERITOS
  CONTRATACION_DIRECTA
  MINIMA_CUANTIA
  CONVENIO_ASOCIACION
  ARRENDAMIENTO
  OTRA
}

enum EstadoValidacionDocumentoContrato {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum TipoPersonaContratista {
  NATURAL
  JURIDICA
}

model Contratista {
  id                 String                 @id @default(cuid())
  identificacion     String                 @unique
  tipoPersona        TipoPersonaContratista @default(NATURAL)
  nombres            String?
  apellidos          String?
  nombreORazonSocial String
  regimenTributario  RegimenTributario?
  granContribuyente  Boolean                @default(false)
  contactoEmail      String?
  contactoTelefono   String?
  direccion          String?
  departamento       String?
  ciudad             String?
  usuarioId          String?                @unique
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  usuario     Usuario?                @relation("ContratistaUsuario", fields: [usuarioId], references: [id])
  expedientes ExpedienteContractual[]
}

model ExpedienteContractual {
  id                       String             @id @default(cuid())
  numero                   String             @unique
  objeto                   String             @db.Text
  modalidadSeleccion       ModalidadSeleccion
  valor                    Decimal?           @db.Decimal(18, 2)
  numeroContrato           String?
  fechaInicio              DateTime?
  fechaFinEstimada         DateTime?
  dependenciaSolicitanteId String
  etapaActual              EtapaContratacion  @default(PRECONTRACTUAL)
  cerrado                  Boolean            @default(false)
  fechaCierre              DateTime?
  contratistaId            String?
  creadoPorId              String
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  expedienteRelacionadoId String?

  dependenciaSolicitante Dependencia            @relation(fields: [dependenciaSolicitanteId], references: [id])
  contratista            Contratista?           @relation(fields: [contratistaId], references: [id])
  creadoPor              Usuario                @relation("ExpContractualCreadoPor", fields: [creadoPorId], references: [id])
  expedienteRelacionado  ExpedienteContractual? @relation("ExpedienteContractualRelacionado", fields: [expedienteRelacionadoId], references: [id])

  supervisores                ExpedienteContractualSupervisor[]
  etapas                      EtapaExpedienteContractual[]
  documentos                  DocumentoContrato[]
  periodosEventuales          PeriodoInformeEventual[]
  eventos                     EventoContratacion[]
  avisosRechazo               AvisoRechazoDocumento[]
  expedientesQueLoReferencian ExpedienteContractual[]           @relation("ExpedienteContractualRelacionado")

  @@index([etapaActual])
  @@index([dependenciaSolicitanteId])
  @@index([contratistaId])
  @@index([expedienteRelacionadoId])
  @@index([numeroContrato])
}

model ExpedienteContractualSupervisor {
  id           String @id @default(cuid())
  expedienteId String
  usuarioId    String
  rol          String @default("SUPERVISOR")

  expediente ExpedienteContractual @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  usuario    Usuario               @relation("SupervisorDeExpediente", fields: [usuarioId], references: [id])

  @@unique([expedienteId, usuarioId])
  @@index([usuarioId])
}

model EtapaExpedienteContractual {
  id            String            @id @default(cuid())
  expedienteId  String
  etapa         EtapaContratacion
  abiertaEn     DateTime          @default(now())
  completadaEn  DateTime?
  aprobadaPorId String?
  comentario    String?           @db.Text

  expediente  ExpedienteContractual @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  aprobadaPor Usuario?              @relation("EtapaContratacionAprobadaPor", fields: [aprobadaPorId], references: [id])

  @@unique([expedienteId, etapa])
}

model RequisitoDocumentoContratacion {
  id                 String              @id @default(cuid())
  modalidadSeleccion ModalidadSeleccion?
  etapa              EtapaContratacion
  orden              Int                 @default(0)
  nombre             String
  codigoFormato      String?
  obligatorio        Boolean             @default(true)
  gestionadoEnSecop  Boolean             @default(false)
  notaOrigenExterno  String?             @db.Text
  fuente             String?
  activo             Boolean             @default(true)

  documentos         DocumentoContrato[]
  periodosEventuales PeriodoInformeEventual[]

  @@index([modalidadSeleccion])
  @@index([etapa])
}

model DocumentoContrato {
  id           String            @id @default(cuid())
  expedienteId String
  etapa        EtapaContratacion
  categoria    String?
  requisitoId  String?
  nombre       String
  storagePath  String
  mimeType     String
  tamanoBytes  Int
  hashSha256   String?
  subidoPorId  String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  requiereFirma        Boolean                           @default(false)
  firmadoEnSecop       Boolean                           @default(false)
  periodoMes           String?
  periodoEventualId    String?
  estadoValidacion     EstadoValidacionDocumentoContrato @default(PENDIENTE)
  validadoPorId        String?
  validadoEn           DateTime?
  comentarioValidacion String?                           @db.Text

  expediente       ExpedienteContractual           @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  subidoPor        Usuario                         @relation("DocContratoSubidoPor", fields: [subidoPorId], references: [id])
  validadoPor      Usuario?                        @relation("DocContratoValidadoPor", fields: [validadoPorId], references: [id])
  requisito        RequisitoDocumentoContratacion? @relation(fields: [requisitoId], references: [id], onDelete: SetNull)
  periodoEventual  PeriodoInformeEventual?         @relation(fields: [periodoEventualId], references: [id], onDelete: SetNull)
  firmas           FirmaDocumentoContrato[]
  solicitudesFirma SolicitudFirma[]
  avisosRechazo    AvisoRechazoDocumento[]

  @@index([expedienteId])
  @@index([etapa])
  @@index([requisitoId])
  @@index([periodoEventualId])
}

model AvisoRechazoDocumento {
  id                    String   @id @default(cuid())
  expedienteId          String?
  expedienteTramiteId   String?
  documentoContratoId   String?
  documentoExpedienteId String?
  mensaje               String   @db.Text
  rechazadoPorId        String?
  subidoPorId           String
  createdAt             DateTime @default(now())

  expediente          ExpedienteContractual? @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  expedienteTramite   Expediente?            @relation(fields: [expedienteTramiteId], references: [id], onDelete: Cascade)
  documentoContrato   DocumentoContrato?     @relation(fields: [documentoContratoId], references: [id], onDelete: Cascade)
  documentoExpediente ExpedienteDocumento?   @relation(fields: [documentoExpedienteId], references: [id], onDelete: Cascade)
  rechazadoPor        Usuario?               @relation("AvisoRechazoRechazadoPor", fields: [rechazadoPorId], references: [id])
  subidoPor           Usuario                @relation("AvisoRechazoSubidoPor", fields: [subidoPorId], references: [id])

  @@index([expedienteId])
  @@index([expedienteTramiteId])
  @@index([documentoContratoId])
  @@index([documentoExpedienteId])
}

model PeriodoInformeEventual {
  id           String   @id @default(cuid())
  expedienteId String
  requisitoId  String
  nombre       String
  creadoPorId  String?
  createdAt    DateTime @default(now())

  expediente ExpedienteContractual          @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  requisito  RequisitoDocumentoContratacion @relation(fields: [requisitoId], references: [id], onDelete: Cascade)
  documentos DocumentoContrato[]

  @@index([expedienteId])
  @@index([requisitoId])
}

model FirmaDocumentoContrato {
  id                String    @id @default(cuid())
  documentoId       String
  usuarioId         String
  fechaHora         DateTime  @default(now())
  hashContenido     String
  ip                String?
  userAgent         String?
  proveedor         String    @default("interno")
  formato           String    @default("hash-sha256")
  selloTiempoEn     DateTime?
  selloTiempoFuente String?
  selloTiempoToken  String?

  documento        DocumentoContrato @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  usuario          Usuario           @relation("FirmaDocContratoUsuario", fields: [usuarioId], references: [id])
  solicitudesFirma SolicitudFirma[]  @relation("SolicitudFirmaEventoContrato")

  @@index([documentoId])
  @@index([usuarioId])
}

model EventoContratacion {
  id           String   @id @default(cuid())
  expedienteId String
  tipo         String
  detalle      String?  @db.Text
  usuarioId    String?
  createdAt    DateTime @default(now())

  expediente ExpedienteContractual @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  usuario    Usuario?              @relation("EventoContratacionUsuario", fields: [usuarioId], references: [id])

  @@index([expedienteId])
}
