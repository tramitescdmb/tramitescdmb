/**
 * Punto de geoposición capturado en campo por un funcionario de la CDMB (ej. durante la "visita
 * técnica" que exige la mayoría de los procedimientos — ver la descripción del paso en
 * data/tramites/*.json, que literalmente pide "geo-referenciación del predio... registrando los
 * datos en el SINCA"). A diferencia de los campos ubicacion.../solicitanteUbicacion... de Expediente
 * (capturados una vez al radicar, por dirección o a mano desde un mapa), esto se captura desde el GPS real del
 * dispositivo del funcionario (navigator.geolocation) durante cualquier paso posterior — puede haber
 * más de uno por expediente si hay varias visitas en distintos pasos. No está atado a un trámite en
 * particular: la "visita técnica" es común a la mayoría, así que el botón de captura está siempre
 * disponible en el paso actual, y cada funcionario lo usa si corresponde a su procedimiento.
 */
model VisitaTecnica {
  id                String   @id @default(cuid())
  expedienteId      String
  pasoNumero        Int
  lat               Float
  lon               Float
  planaX            Float?
  planaY            Float?
  cartesianaX       Float?
  cartesianaY       Float?
  cartesianaZ       Float?
  precisionM        Float?
  capturaManual     Boolean  @default(false)
  fueraJurisdiccion Boolean  @default(false)
  nota              String?  @db.Text
  capturadoPorId    String
  // Momento real de la captura (GPS del dispositivo o ingreso manual) — distinto de `createdAt`
  // (cuándo quedó guardada en el servidor), que puede ser más tarde si se capturó sin conexión.
  capturadoEn       DateTime @default(now())
  createdAt         DateTime @default(now())

  expediente   Expediente          @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  capturadoPor Usuario             @relation(fields: [capturadoPorId], references: [id])
  fotos        VisitaTecnicaFoto[]

  @@index([expedienteId])
}

model VisitaTecnicaFoto {
  id          String    @id @default(cuid())
  visitaId    String
  storagePath String
  mimeType    String
  tamanoBytes Int
  // Metadatos EXIF de la foto, cuando la cámara los conserva — no siempre existen (fecha/GPS se
  // pueden perder al comprimir o si el dispositivo los omite), por eso todos son opcionales.
  tomadaEn    DateTime?
  latExif     Float?
  lonExif     Float?
  createdAt   DateTime  @default(now())

  visita VisitaTecnica @relation(fields: [visitaId], references: [id], onDelete: Cascade)

  @@index([visitaId])
}

