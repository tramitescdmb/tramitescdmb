generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Configuración de apariencia (logos del header/footer institucional) — fila
// única "singleton", igual patrón que el proyecto Negocios Verdes
// (configuracion_sitio): logo propio + los 3 sellos oficiales de gov.co.
// ---------------------------------------------------------------------------

model ConfiguracionSitio {
  id               String  @id @default("singleton")
  logoUrl          String? // logo de la CDMB, header + footer
  logoPath         String?
  logoGovcoUrl     String? // franja azul superior
  logoGovcoPath    String?
  logoColombiaUrl  String? // franja azul del footer
  logoColombiaPath String?
  logoPotenciaUrl  String? // "Colombia Potencia de la Vida", franja del footer
  logoPotenciaPath String?

  // Seguridad de acceso (MoReq 6.12): antes eran constantes fijas en
  // /api/auth/login — ahora configurables desde /admin/seguridad.
  loginMaxIntentos    Int @default(5)
  loginVentanaMinutos Int @default(15)

  // "Locker" del módulo SGDEA: cuando es false, solo un ADMIN ve y entra al
  // módulo de Correspondencia y Archivo — para desplegarlo cuando esté listo,
  // sin que los funcionarios lo vean mientras tanto (obtenerPermisosUsuario lo
  // trata como "sin rol de correspondencia" para todos menos ADMIN).
  sgdeaVisibleFuncionarios Boolean @default(true)

  // URL de una Autoridad de Sello de Tiempo RFC-3161 (opcional). Con valor, cada
  // firma electrónica pide un token de sello de tiempo verificable; vacío = el
  // sello es la bitácora encadenada por hash del SGDEA. Ver src/lib/sello-tiempo.ts.
  selloTiempoTsaUrl String?

  // Política de contraseñas (MoReq 6.29/6.32/6.35): antes solo se exigía un
  // mínimo de 8 caracteres fijo en código. Solo se aplica al FIJAR una
  // contraseña nueva (creación o restablecimiento por un ADMIN) — nunca
  // revalida contraseñas ya existentes, eso no es posible sobre un hash.
  passwordLongitudMinima     Int     @default(8)
  passwordLongitudMaxima     Int     @default(72) // bcrypt ignora bytes después del 72, sin importar el valor aquí
  passwordRequiereMayuscula  Boolean @default(false)
  passwordRequiereNumero     Boolean @default(false)
  passwordRequiereEspecial   Boolean @default(false)
  passwordHistorialCantidad  Int     @default(0) // 0 = no revisar contraseñas anteriores
  passwordVigenciaDias       Int? // null = no vence
  passwordVigenciaMinimaDias Int     @default(0) // 0 = sin mínimo; evita ciclar contraseñas para saltarse el histórico. Solo aplica al cambio por el propio usuario, no a un restablecimiento por ADMIN.

  // Formatos de captura permitidos al subir un documento (MoReq 3.1) — antes una
  // lista fija en código (src/lib/uploads-config.ts). Vacío ([]) se trata como
  // "usar los valores por defecto de fábrica", nunca como "no permitir nada".
  extensionesPermitidas String[] @default(["pdf", "jpg", "jpeg", "png", "doc", "docx", "xls", "xlsx"])

  // Jornada laboral de la entidad — alimenta el cálculo de términos de ley (días
  // hábiles) y las métricas de tiempo del SGDEA. `jornadaDiasSemana` usa la
  // convención de getUTCDay: 0=domingo, 1=lunes … 6=sábado.
  jornadaDiasSemana      Int[]   @default([1, 2, 3, 4, 5])
  jornadaHoraInicio      String  @default("08:00")
  jornadaHoraFin         String  @default("17:00")
  // Jornada partida (ej. 8–12 y 2–6): si estos dos están puestos, `jornadaHoraInicio`/
  // `jornadaHoraFin` son el bloque de la mañana y estos el de la tarde. null = jornada continua.
  jornadaHoraInicioTarde String?
  jornadaHoraFinTarde    String?

  updatedAt DateTime @updatedAt
}

// Días adicionales que la entidad NO labora, más allá de los festivos de ley de
// Colombia (que se calculan solos en src/lib/dias-habiles.ts): días compensados,
// cierres institucionales, puentes internos. Se descuentan del cálculo de
// términos de ley y de las métricas de tiempo.
model DiaNoLaborado {
  id        String   @id @default(cuid())
  fecha     DateTime @unique @db.Date
  motivo    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Usuarios internos (funcionarios CDMB)
// ---------------------------------------------------------------------------

enum RolUsuario {
  ADMIN
  FUNCIONARIO
}

/**
 * Cargo real dentro de la CDMB (Subdirector SEYCA, Profesional en Derecho, etc.) —
 * es distinto del RolUsuario (que es el permiso dentro de la app). El cargo es
 * "quién es" el funcionario en la organización; se usa para resaltar qué pasos
 * de un trámite le corresponden. Catálogo fijo, sembrado en prisma/seed.ts a
 * partir de los "responsables" reales de los 30 procedimientos — ver
 * src/lib/cargos.ts para las palabras clave de coincidencia con cada paso.
 */
model Cargo {
  id                    String       @id @default(cuid())
  nombre                String       @unique
  orden                 Int          @default(0)
  usuarios              Usuario[]
  expedientesAsignacion Expediente[] @relation("ExpedienteCargosAsignados")
}

model Usuario {
  id                      String       @id @default(cuid())
  email                   String       @unique
  nombre                  String
  passwordHash            String
  // Cuándo se fijó la contraseña actual (creación o último restablecimiento
  // por un ADMIN) — base para calcular la vigencia (MoReq 6.35). Null en
  // cuentas que ya existían antes de este campo: se trata como "sin vencer".
  passwordCambiadaEn      DateTime?
  rol                     RolUsuario   @default(FUNCIONARIO)
  // Denominación del empleo (nomenclatura de empleos públicos, Decreto 1083/2015):
  // el cargo NOMINAL del funcionario. `denominacionEmpleo` guarda la CLAVE del
  // catálogo (src/lib/denominacion-empleo.ts), `denominacionComplemento` el sufijo
  // libre ("en Tecnologías de Información"), y `sexo` (M/F) decide si el sello de
  // firma usa la forma masculina o femenina. Distinto del modelo Cargo, que es una
  // clave funcional para el bloqueo de pasos de trámite (ver src/lib/cargos.ts).
  denominacionEmpleo      String?
  denominacionComplemento String?
  sexo                    String? // "M" | "F"
  // ¿Puede firmar electrónicamente oficios/memorandos? Por defecto sí (todos
  // pueden en algún momento); un ADMIN puede retirarlo por persona.
  accesoFirma             Boolean      @default(true)
  activo                  Boolean      @default(true)
  // Estado detallado de la cuenta (MoReq 6.36) — `activo` sigue siendo lo que
  // efectivamente evalúa todo el control de acceso (obtenerPermisosUsuario),
  // así que se mantiene siempre en sincronía con este campo (HABILITADA→true,
  // cualquier otro→false) en cada sitio que lo cambia: no hace falta tocar los
  // demás lugares que ya leen `activo`. BLOQUEADA la fija el propio login tras
  // exceder los intentos fallidos (persiste hasta que un ADMIN la levante,
  // MoReq 6.13); SUSPENDIDA es una marca manual de un ADMIN, distinta de
  // DESHABILITADA para poder diferenciar "de baja" de "temporalmente fuera".
  estadoCuenta            EstadoCuenta @default(HABILITADA)
  createdAt               DateTime     @default(now())

  // true = la identidad la valida el directorio activo de la CDMB (API externa,
  // src/lib/directorio-activo.ts). Estos usuarios NO tienen contraseña propia en
  // esta app: `passwordHash` queda con un valor centinela que nunca verifica, y
  // el formulario normal de correo/contraseña siempre los rechaza. Se dan de
  // alta solos la primera vez que inician sesión por directorio activo.
  directorioActivo Boolean @default(false)

  // Un funcionario puede tener varios cargos a la vez (ej. cubre dos puestos
  // en un área pequeña) — se usan TODOS para el resaltado/bloqueo por paso
  // (ver src/lib/cargos.ts), no solo el primero.
  cargos                Cargo[]
  tramitesAcceso        UsuarioTramiteAcceso[]
  seccionesAcceso       UsuarioSeccionAcceso[]
  expedientesCreados    Expediente[]           @relation("CreadoPor")
  expedientesAsignados  Expediente[]           @relation("ResponsableActual")
  expedientesAsignacion Expediente[]           @relation("ExpedienteUsuariosAsignados")
  documentos            ExpedienteDocumento[]
  eventos               ExpedienteEvento[]
  registrosAuditoria    RegistroAuditoria[]
  visitasTecnicas       VisitaTecnica[]
  historialPasswords    HistorialPassword[]

  // --- SGDEA / Correspondencia (ver bloque al final del archivo) ---
  // Dependencia (oficina) a la que pertenece el funcionario, y rol dentro del
  // módulo de correspondencia (null + no ADMIN = sin acceso al módulo).
  dependenciaId                  String?
  rolCorrespondencia             RolCorrespondencia?
  // Vigencia del rol (MoReq 6.3: quitar el rol automáticamente al vencer un período) — opcional; si se
  // pasa la fecha, obtenerPermisosUsuario() lo trata como sin rol asignado sin que un ADMIN tenga que
  // volver a entrar a quitárselo. El valor del campo se conserva (no se borra solo) para dejar rastro de
  // qué rol tuvo y hasta cuándo.
  rolCorrespondenciaVigenteHasta DateTime?

  dependencia                     Dependencia?            @relation("UsuarioDependencia", fields: [dependenciaId], references: [id])
  dependenciasResponsable         Dependencia[]           @relation("DependenciaResponsable")
  comunicacionesRadicadas         Comunicacion[]          @relation("ComunicacionRadicadaPor")
  comunicacionesRespondidas       Comunicacion[]          @relation("ComunicacionRespuestaPor")
  comunicacionesDespachadas       Comunicacion[]          @relation("ComunicacionDespachadaPor")
  transferenciasConfirmadas       Comunicacion[]          @relation("ComunicacionTransferenciaConfirmadaPor")
  comunicacionDocumentos          ComunicacionDocumento[] @relation("ComunicacionDocumentoSubidoPor")
  distribucionesRecibidas         Distribucion[]          @relation("DistribucionUsuario")
  expedientesDocumentalesCreados  ExpedienteDocumental[]  @relation("ExpedienteDocumentalCreadoPor")
  expedientesDocumentalesCerrados ExpedienteDocumental[]  @relation("ExpedienteDocumentalCerradoPor")
  prestamosRecibidos              PrestamoExpediente[]    @relation("PrestamoPrestadoA")
  prestamosEntregados             PrestamoExpediente[]    @relation("PrestamoPrestadoPor")
  documentosArchivoSubidos        DocumentoArchivo[]      @relation("DocumentoArchivoSubidoPor")
  documentosArchivoRetirados      DocumentoArchivo[]      @relation("DocumentoArchivoRetiradoPor")
  distribucionesAsignadas         Distribucion[]          @relation("DistribucionAsignadoPor")
  firmas                          Firma[]                 @relation("FirmaUsuario")
  auditoriasDoc                   AuditoriaDoc[]          @relation("AuditoriaDocUsuario")
  actasEliminacionAprobadas       ActaEliminacion[]       @relation("ActaEliminacionAprobadaPor")
  flujosCreados                   FlujoTrabajo[]          @relation("FlujoCreadoPor")
  instanciasFlujoIniciadas        InstanciaFlujo[]        @relation("InstanciaFlujoIniciadoPor")
  pasosFlujoEjecutados            PasoEjecutado[]         @relation("PasoEjecutadoResponsable")

  @@index([dependenciaId])
}

// Contraseñas anteriores de un usuario (MoReq 6.30), para impedir que
// restablezca a una que ya usó. Solo se consulta cuando
// ConfiguracionSitio.passwordHistorialCantidad > 0; se recorta a esa cantidad
// en cada cambio (ver src/lib/password-policy.ts). El passwordHash ACTUAL del
// usuario vive en Usuario, no aquí — esta tabla solo guarda las reemplazadas.
model HistorialPassword {
  id        String   @id @default(cuid())
  usuarioId String
  hash      String
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, createdAt])
}

// ---------------------------------------------------------------------------
// Acceso por trámite (admin-only, se configura desde /usuarios/[id]): a
// diferencia de Cargo (el puesto real, usado para resaltar/bloquear pasos por
// texto) y RolUsuario (Admin/Funcionario, permisos administrativos), esto
// controla, trámite por trámite del catálogo de "Trámites ambientales 2.0",
// si un funcionario puede solo VER o también EDITAR (crear/avanzar/subir
// documentos). Sin ninguna fila para un trámite dado, el funcionario NO lo ve
// (denegado por defecto) — el ADMIN siempre tiene acceso total, sin
// excepción. Reemplazó a un primer diseño con una tabla "Rol" reutilizable
// (nunca llegó a usarse):
// con pocos usuarios reales, asignar directo por persona es más simple y
// claro que crear roles intermedios. Ver src/lib/permisos.ts.
// ---------------------------------------------------------------------------

enum NivelAccesoTramite {
  VER
  EDITAR
}

model UsuarioTramiteAcceso {
  id            String             @id @default(cuid())
  usuarioId     String
  tramiteTipoId String
  nivel         NivelAccesoTramite

  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tramiteTipo TramiteTipo @relation(fields: [tramiteTipoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tramiteTipoId])
  @@index([tramiteTipoId])
}

// Acceso a las secciones de solo lectura VITAL y SINCA 1.0 — a diferencia de
// UsuarioTramiteAcceso no hay nivel (todo es consulta, nadie edita nada ahí),
// solo si puede entrar o no a cada pestaña. VITAL agrupa "Solicitudes" y
// "Recientes" en un solo permiso base (son la misma información, dos vistas)
// y dashboard aparte; SINCA 1.0 tiene Solicitudes (base), Dashboard y Minería
// de datos como tres permisos independientes — Minería de datos es la más
// sensible (pensada para directivos, no cualquier funcionario). Denegado por
// defecto, igual que UsuarioTramiteAcceso.
enum SeccionSoloLectura {
  VITAL_BASE
  VITAL_DASHBOARD
  SINCA_BASE
  SINCA_DASHBOARD
  SINCA_MINERIA
}

model UsuarioSeccionAcceso {
  id        String             @id @default(cuid())
  usuarioId String
  seccion   SeccionSoloLectura

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, seccion])
}

// ---------------------------------------------------------------------------
// Auditoría del sistema (distinta de ExpedienteEvento, que es la bitácora de
// UN expediente) — acciones a nivel de cuenta: logins, gestión de usuarios,
// cambios de configuración. Solo lectura desde /auditoria (solo ADMIN).
// ---------------------------------------------------------------------------

enum TipoAuditoria {
  LOGIN_EXITOSO
  LOGIN_FALLIDO
  USUARIO_CREADO
  USUARIO_ACTIVADO
  USUARIO_DESACTIVADO
  USUARIO_BLOQUEADO
  USUARIO_ACTUALIZADO
  CONFIGURACION_ACTUALIZADA
}

// MoReq 6.36: estados de cuenta distinguibles (antes solo había activo/inactivo).
enum EstadoCuenta {
  HABILITADA
  DESHABILITADA
  BLOQUEADA
  SUSPENDIDA
}

model RegistroAuditoria {
  id           String        @id @default(cuid())
  tipo         TipoAuditoria
  descripcion  String        @db.Text
  usuarioId    String? // quién hizo la acción; null si el login fallido no correspondía a ningún usuario real
  emailIntento String? // correo usado en un intento de login (exitoso o no), aunque no exista el usuario
  createdAt    DateTime      @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([tipo])
  @@index([usuarioId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// SINCA 1.0 — histórico de trámites ambientales con resolución de fondo.
// Espejo local (SOLO CONSULTA) del API externo `GET /api/presinca/resoluciones`
// (~5.163 registros al 2026-08). NADA en la app crea, edita ni borra estos
// datos desde la interfaz: se sincronizan desde el API con src/lib/sinca-sync.ts
// (backfill único + refresco diario) y solo se leen. `nroSolicitud` es el
// identificador que trae SINCA 1.0 (`nrosolicitud_sol`).
// ---------------------------------------------------------------------------

model SincaResolucion {
  nroSolicitud        Int       @id
  numeroResolucion    String?
  fechaResolucion     DateTime? // fecha_documento: fecha de la resolución de fondo
  anioResolucion      Int? // derivado de fechaResolucion, para agrupar sin castear en cada consulta
  fechaRecibido       DateTime? // fecharecibido_sol
  proyecto            String    @db.Text // proyecto_sol
  tipoSolicitud       String? // "(CA) CONCESIONES DE AGUAS" tal cual lo entrega el API
  tipoSolicitudCodigo String? // "CA" (derivado)
  tipoSolicitudNombre String? // "CONCESIONES DE AGUAS" (derivado)
  indTipoSolicitud    String? // indtiposol_sol.label — Normal / Renovación
  estado              String? // estado_sol.label — Aprobada, Negada, Desestimiento, ...
  origen              String? // origen_sol.label, si viene
  expediente          String? // expediente_sol
  departamento        String?
  municipio           String?
  barrio              String?
  correo              String? // correo_sol
  representanteLegal  String? // replegal_sol
  idRepresentante     String? // idreplegal_sol (NIT/cédula del representante)
  cantidadDocumentos  Int       @default(0) // cantidad_emision_documentos
  cantidadInteresados Int       @default(0) // cantidad_interesado
  lat                 Float?
  lon                 Float?

  // Campos que solo entrega el endpoint de detalle (GET /presinca/resoluciones/{n}),
  // no el listado. Se llenan con el paso de enriquecimiento (src/lib/sinca-sync.ts).
  diasResolucion    Int? // fechaResolucion - fechaRecibido, en días (tiempo de trámite)
  solicitanteNit    String? // interesado[0].nit.numero_nit
  solicitanteNombre String? // razón social o nombre del interesado
  enriquecidoEn     DateTime? // null = falta traer el detalle

  raw            Json // registro original completo del API (para la ficha de detalle)
  sincronizadoEn DateTime @default(now())

  @@index([anioResolucion])
  @@index([tipoSolicitudCodigo])
  @@index([estado])
  @@index([municipio])
  @@index([expediente])
  @@index([fechaResolucion])
  @@index([diasResolucion])
  @@index([solicitanteNit])
  @@index([enriquecidoEn])
}

model SincaSincronizacion {
  id           String    @id @default(cuid())
  iniciadoEn   DateTime  @default(now())
  terminadoEn  DateTime?
  ok           Boolean   @default(false)
  totalApi     Int?
  creados      Int?
  actualizados Int?
  eliminados   Int?
  mensajeError String?   @db.Text
  disparadoPor String? // "cron", "manual:<usuario>", "script"
}

/// Fila única (id fijo) con el registro completo de NIT/terceros de SINCA 1.0 ya agrupado por
/// tercero — recalcularlo recorre las ~33 mil filas del API (~20s), así que se guarda aquí en
/// vez de con unstable_cache: el payload agrupado pesa más de los 2MB que esa caché admite.
model SincaNitSnapshot {
  id          String   @id @default("actual")
  datos       Json
  calculadoEn DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Catálogo de trámites (datos de referencia, sembrados desde data/tramites/*.json)
// ---------------------------------------------------------------------------

model TramiteTipo {
  id                       String   @id @default(cuid())
  codigo                   String   @unique // ej. M-DA-PR05
  version                  String
  fecha                    DateTime
  proceso                  String
  nombre                   String
  nombreCompleto           String
  slug                     String   @unique
  archivoFuente            String
  objeto                   String   @db.Text
  resumen                  String?  @db.Text // frase natural "Este trámite..." para la UI (objeto es la redacción formal del PDF)
  alcance                  String   @db.Text
  autoridadResponsabilidad String   @db.Text
  suitNumeros              String[] @default([]) // número(s) de ficha en el SUIT (Sistema Único de Información de Trámites), si está inscrito — algunos trámites tienen más de uno (ej. concesión de aguas superficiales + subterráneas por separado)
  activo                   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  flujos               Flujo[]
  documentosRequeridos DocumentoRequeridoDefinicion[]
  expedientes          Expediente[]
  usuariosConAcceso    UsuarioTramiteAcceso[]
}

model DocumentoRequeridoDefinicion {
  id            String           @id @default(cuid())
  tramiteTipoId String
  orden         Int
  nombre        String
  obligatorio   Boolean          @default(true)
  notas         String?
  aplicaA       TipoSolicitante? // null = aplica a cualquier solicitante; si no, solo es obligatorio para ese tipo (ej. "Certificado de Existencia y Representación Legal" solo para JURIDICA)

  tramiteTipo TramiteTipo @relation(fields: [tramiteTipoId], references: [id], onDelete: Cascade)

  @@index([tramiteTipoId])
}

model Flujo {
  id             String  @id @default(cuid())
  tramiteTipoId  String
  codigo         String // inicio | renovacion | ...
  nombre         String
  esFlujoInicial Boolean @default(false)
  orden          Int     @default(0)
  suitNumero     String? // ficha del SUIT específica de ESTE flujo, cuando el SUIT registra cada modalidad por separado (ej. M-DA-PR21: "Concesión de Aguas Superficiales" y "Concesión de Aguas Subterráneas" son un solo procedimiento/PDF pero dos fichas SUIT distintas)
  resumen        String? @db.Text // frase natural de ESTE flujo, para cuando se ve enfocado en un solo flujo (?flujo=...) y no debe mencionar la otra modalidad

  tramiteTipo TramiteTipo      @relation(fields: [tramiteTipoId], references: [id], onDelete: Cascade)
  pasos       PasoDefinicion[]
  expedientes Expediente[]

  @@unique([tramiteTipoId, codigo])
}

model PasoDefinicion {
  id           String   @id @default(cuid())
  flujoId      String
  numero       Int
  titulo       String
  descripcion  String   @db.Text
  responsables String[]
  documentos   String[]
  tiempo       String?
  tiempoDias   Int?
  esDecision   Boolean  @default(false)
  opciones     Json?

  flujo Flujo @relation(fields: [flujoId], references: [id], onDelete: Cascade)

  @@unique([flujoId, numero])
}

// ---------------------------------------------------------------------------
// Expedientes (instancias reales de un trámite gestionadas por la CDMB)
// ---------------------------------------------------------------------------

enum EstadoExpediente {
  RADICADO
  EN_TRAMITE
  INFORMACION_ADICIONAL_REQUERIDA
  SUSPENDIDO
  APROBADO
  NEGADO
  DESISTIDO
  ARCHIVADO
  RECHAZADO
}

enum TipoSolicitante {
  NATURAL
  JURIDICA
}

enum RegimenTributario {
  RESPONSABLE_IVA
  NO_RESPONSABLE_IVA
  SIMPLE_TRIBUTACION
  REGIMEN_ESPECIAL
  OTRO
}

enum ClaseSolicitud {
  NUEVA
  RENOVACION
}

/**
 * Registro maestro por NIT/cédula — antes cada Expediente guardaba su propia
 * copia de los datos del solicitante, sin nada que los conectara: la misma
 * empresa podía quedar escrita distinto en cada trámite, y no había forma de
 * preguntar "¿qué otros trámites tiene esta NIT con la CDMB?". Ahora, al
 * radicar, se busca por identificación — si ya existe se reutiliza (y se
 * actualizan los datos de contacto), si no existe se crea aquí.
 * El régimen tributario y "gran contribuyente" NO son decorativos: la CDMB
 * a veces le paga a estos mismos terceros (o cobra estampillas), y el
 * régimen determina retenciones/beneficios — por eso se guardan aquí y no
 * en cada Expediente. A propósito no se replicó el formulario contable
 * completo del sistema viejo (clave contable, RUP, actividad económica...)
 * — eso vive en el sistema contable real de la CDMB, no en SINCA.
 * `Expediente.solicitanteNombre/Identificacion/...` se mantienen aparte
 * (no se borran): son la foto de cómo era el solicitante EN ESE MOMENTO,
 * que para un trámite regulatorio es lo correcto conservar aunque el
 * tercero cambie de nombre o dirección después.
 */
model Solicitante {
  id                String             @id @default(cuid())
  tipo              TipoSolicitante
  identificacion    String             @unique // NIT o cédula, tal como se escribe (ej. "900123456-1")
  // Separados para poder buscar por nombre o por apellido (persona natural) — para persona
  // jurídica normalmente solo aplica razonSocial, pero se deja nombres/apellidos libres por si
  // hace falta guardar el nombre de un contacto/representante. Validado en la app según `tipo`,
  // no aquí, porque cuál es obligatorio depende del tipo.
  nombres           String?
  apellidos         String?
  razonSocial       String?
  regimenTributario RegimenTributario?
  granContribuyente Boolean            @default(false)
  email             String?
  telefono          String?
  direccion         String?
  municipio         String // obligatorio — incluye "Fuera de la jurisdicción" como opción válida explícita, ver src/lib/municipios.ts
  // Departamento — solo se diligencia cuando el municipio está fuera de la
  // jurisdicción de la CDMB y se escribe a mano (para caracterizar el origen).
  departamento      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  expedientes    Expediente[]
  comunicaciones Comunicacion[] // como remitente/destinatario en el módulo de correspondencia
}

model Expediente {
  id            String @id @default(cuid())
  numero        String @unique // ej. M-DA-PR05-2026-0001
  tramiteTipoId String
  flujoId       String

  solicitanteId             String? // vínculo al registro maestro por NIT/cédula (ver Solicitante) — null en expedientes creados antes de este campo
  solicitanteTipo           TipoSolicitante @default(NATURAL)
  solicitanteNombre         String
  solicitanteIdentificacion String
  solicitanteEmail          String?
  solicitanteTelefono       String?
  solicitanteDireccion      String? // dirección del solicitante — distinta de la del predio (ej. empresa con sede en otra ciudad)
  predioDireccion           String? // dirección del predio o del lugar donde se desarrolla el proyecto
  municipio                 String // uno de los 13 municipios de la jurisdicción CDMB (ver src/lib/municipios.ts)

  claseSolicitud ClaseSolicitud? // Nueva / Renovación — el PDF del procedimiento no siempre lo distingue como flujo aparte

  // Datos del predio que el procedimiento oficial no siempre pide como tal, pero que sí importan
  // para la decisión real (ej. el área determina cuánta agua se puede conceder) o son identificadores
  // legales reales del predio — no están todos los trámites, por eso opcionales.
  predioNombre         String? // ej. "Finca La Esperanza" — un predio rural casi siempre tiene nombre propio, distinto de la dirección
  predioCatastral      String? // número catastral (IGAC)
  predioMatricula      String? // matrícula inmobiliaria
  predioAreaM2         Float?
  predioAreaCultivosM2 Float?
  predioAreaBosqueM2   Float?
  predioViviendas      Int?

  // Ubicación del predio/proyecto tomada en campo (mapa OSM) — opcional, no todo trámite la necesita.
  // Se puede cargar desde cualquiera de las 3 representaciones (elipsoidal/plana/cartesiana);
  // lat/lon (WGS84) es la que manda internamente, las demás se recalculan siempre en el
  // servidor a partir de ella — ver src/lib/coordenadas.ts. Sin altura: se probó y se quitó
  // a pedido del usuario (no la necesitan para nada de este trámite).
  ubicacionLat         Float? // elipsoidal WGS84
  ubicacionLon         Float? // elipsoidal WGS84
  ubicacionPlanaX      Float? // MAGNA-SIRGAS Origen-Nacional (EPSG:9377)
  ubicacionPlanaY      Float?
  ubicacionCartesianaX Float? // ECEF geocéntrica (mismo elipsoide GRS80)
  ubicacionCartesianaY Float?
  ubicacionCartesianaZ Float?

  // Dirección/ubicación del SOLICITANTE — distinta de la del predio/proyecto de arriba (ej.
  // una empresa con sede en Bucaramanga que solicita un permiso para un proyecto en Vetas).
  // Mismo esquema, misma lógica de recálculo en el servidor.
  solicitanteUbicacionLat         Float?
  solicitanteUbicacionLon         Float?
  solicitanteUbicacionPlanaX      Float?
  solicitanteUbicacionPlanaY      Float?
  solicitanteUbicacionCartesianaX Float?
  solicitanteUbicacionCartesianaY Float?
  solicitanteUbicacionCartesianaZ Float?

  estado           EstadoExpediente @default(RADICADO)
  pasoActualNumero Int              @default(1)

  createdById         String
  responsableActualId String?

  fechaRadicacion       DateTime @default(now())
  fechaUltimoMovimiento DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tramiteTipo       TramiteTipo  @relation(fields: [tramiteTipoId], references: [id])
  flujo             Flujo        @relation(fields: [flujoId], references: [id])
  creadoPor         Usuario      @relation("CreadoPor", fields: [createdById], references: [id])
  responsableActual Usuario?     @relation("ResponsableActual", fields: [responsableActualId], references: [id])
  solicitante       Solicitante? @relation(fields: [solicitanteId], references: [id])

  documentos      ExpedienteDocumento[]
  eventos         ExpedienteEvento[]
  visitasTecnicas VisitaTecnica[]

  /**
   * Asignación del expediente completo (distinta de `responsableActual`, que
   * es solo "quién lo tiene ahora mismo" y cambia a medida que avanza de
   * paso). Esto es "quién(es) deben trabajar este expediente" — a uno o
   * varios usuarios puntuales, y/o a uno o varios cargos (cualquiera que
   * tenga ese cargo). Por ahora es solo informativo/visible: no bloquea a
   * nadie más para editar el expediente (decisión explícita del usuario —
   * convertir esto en una restricción real de permisos es un cambio
   * aparte, a confirmar antes de hacerlo).
   */
  usuariosAsignados Usuario[] @relation("ExpedienteUsuariosAsignados")
  cargosAsignados   Cargo[]   @relation("ExpedienteCargosAsignados")

  // Comunicaciones (correspondencia/memorandos) archivadas dentro de este expediente — unificación SGDEA.
  comunicaciones Comunicacion[]

  @@index([tramiteTipoId])
  @@index([estado])
  @@index([municipio])
  @@index([solicitanteId])
}

model ExpedienteDocumento {
  id           String   @id @default(cuid())
  expedienteId String
  pasoNumero   Int?
  nombre       String
  descripcion  String?
  storagePath  String
  mimeType     String
  tamanoBytes  Int
  subidoPorId  String
  createdAt    DateTime @default(now())

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  subidoPor  Usuario    @relation(fields: [subidoPorId], references: [id])

  @@index([expedienteId])
}

enum TipoEvento {
  CREACION
  CAMBIO_ESTADO
  AVANCE_PASO
  DOCUMENTO_SUBIDO
  DOCUMENTO_ELIMINADO
  COMENTARIO
  ASIGNACION_CAMBIADA
  VISITA_REGISTRADA
}

model ExpedienteEvento {
  id             String            @id @default(cuid())
  expedienteId   String
  tipo           TipoEvento
  descripcion    String            @db.Text
  pasoNumero     Int?
  estadoAnterior EstadoExpediente?
  estadoNuevo    EstadoExpediente?
  usuarioId      String
  createdAt      DateTime          @default(now())

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])

  @@index([expedienteId])
}

/**
 * Punto de geoposición capturado en campo por un funcionario de la CDMB (ej. durante la "visita
 * técnica" que exige la mayoría de los procedimientos — ver la descripción del paso en
 * data/tramites/*.json, que literalmente pide "geo-referenciación del predio... registrando los
 * datos en el SINCA"). A diferencia de los campos ubicacion.../solicitanteUbicacion... de Expediente
 * (capturados una vez al radicar, por dirección o a mano desde un mapa), esto se captura desde el GPS real del
 * dispositivo del funcionario (navigator.geolocation) durante cualquier paso posterior — puede haber
 * más de uno por expediente si hay varias visitas en distintos pasos. No está atado a un trámite en
 * particular: la "visita técnica" es común a la mayoría, así que el botón de captura está siempre
 * disponible en el paso actual, y cada funcionario lo usa si corresponde a su procedimiento.
 */
model VisitaTecnica {
  id             String   @id @default(cuid())
  expedienteId   String
  pasoNumero     Int
  lat            Float
  lon            Float
  planaX         Float?
  planaY         Float?
  cartesianaX    Float?
  cartesianaY    Float?
  cartesianaZ    Float?
  precisionM     Float? // exactitud reportada por el GPS del dispositivo (navigator.geolocation) — informativa, no se valida
  nota           String?  @db.Text
  capturadoPorId String
  createdAt      DateTime @default(now())

  expediente   Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  capturadoPor Usuario    @relation(fields: [capturadoPorId], references: [id])

  @@index([expedienteId])
}

// ---------------------------------------------------------------------------
// Integración VITAL/OTIC (MinAmbiente) — espejo de solo lectura de las
// solicitudes que el ciudadano radica en la Ventanilla Integral de Trámites
// Ambientales en Línea (VITAL), traídas vía los servicios web expuestos por
// X-ROAD (ver src/lib/vital.ts). Por ahora es de un solo sentido: se
// sincroniza PARA VER, no se reporta nada de vuelta a VITAL (eso — avance de
// actividad, asociación de radicado — quedó explícitamente fuera de alcance).
// ---------------------------------------------------------------------------

model SolicitudVital {
  id                 String    @id @default(cuid())
  idVital            String    @unique // número VITAL de la solicitud (idVital)
  idTramiteVital     Int // id_tramite en VITAL
  idTramiteAutoridad Int? // idTramiteAutoridad — identificador propio de la CDMB en VITAL, si aplica
  fechaRadicacion    DateTime?
  nombreActividad    String? // última actividad conocida al momento de sincronizar (hu-otic-vital-io-001)

  solicitanteNombre         String?
  solicitanteIdentificacion String?
  solicitanteCorreo         String?
  solicitanteRaw            Json? // respuesta completa de hu-otic-vital-io-003, tal cual (persona natural o jurídica)
  camposTramite             Json? // respuesta completa de hu-otic-vital-io-002, tal cual (campos del formulario)

  // Cuántos documentos reportó wsDocumentos en la última sincronización — puede ser mayor que
  // `documentos.length` si la descarga falló (confirmado en vivo: el servicio /descargar de VITAL
  // devuelve 403 "sin permisos" para TODA descarga hasta ahora, aunque wsDocumentos sí lista los
  // archivos). Null = todavía no se sincronizó con esta columna. Sirve para poder avisar en el
  // detalle que hay un adjunto que VITAL reporta pero no se pudo traer, en vez de mostrar "sin
  // documentos" como si el trámite realmente no tuviera ninguno.
  documentosReportados Int?

  documentos           SolicitudVitalDocumento[]
  ultimaSincronizacion DateTime                  @default(now()) @updatedAt
  createdAt            DateTime                  @default(now())

  @@index([idTramiteVital])
}

/**
 * Trámites de VITAL que la CDMB puede consultar. VITAL no expone un catálogo, así
 * que la lista se descubre: `NOMBRE_TRAMITE_VITAL` (src/lib/vital.ts) trae los
 * conocidos, y el cron va probando ids nuevos con `wsObtenerSolicitudes` — si
 * alguno responde con solicitudes se agrega aquí y se empieza a sincronizar.
 */
model VitalTramite {
  idTramite      Int       @id
  nombre         String?
  activo         Boolean   @default(true)
  detectadoEn    DateTime  @default(now())
  ultimaRevision DateTime?
  ultimoConteo   Int?
}

/**
 * Cursor de la exploración de ids de trámite (fila única).
 */
model VitalDescubrimiento {
  id            String   @id @default("singleton")
  proximoId     Int      @default(1)
  actualizadoEn DateTime @updatedAt
}

model SolicitudVitalDocumento {
  id          String   @id @default(cuid())
  solicitudId String
  nombre      String
  storagePath String // ya descargado del link temporal de VITAL (expira en 1h) y re-subido a nuestro Storage
  mimeType    String
  tamanoBytes Int
  createdAt   DateTime @default(now())

  solicitud SolicitudVital @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@index([solicitudId])
}

// ===========================================================================
// SGDEA — Sistema de Gestión de Documentos Electrónicos de Archivo
// (Correspondencia y gestión documental, conforme al marco del AGN:
//  Ley 594/2000, Acuerdo 060/2001, Acuerdos 03/2015 y 01/2024, MoReq).
// Fase 1: núcleo archivístico + ventanilla de correspondencia RECIBIDA.
// Ver plan y memoria reference-oracle-legacy-cdmb (sistema COR que reemplaza).
// ===========================================================================

// Rol del funcionario DENTRO del módulo de correspondencia (independiente de
// RolUsuario/Cargo). null + no ADMIN = sin acceso al módulo (denegado por
// defecto, mismo criterio que UsuarioTramiteAcceso/UsuarioSeccionAcceso).
enum RolCorrespondencia {
  OPERADOR_VENTANILLA // radica y reparte en la ventanilla única
  FUNCIONARIO_DEPENDENCIA // recibe y responde lo distribuido a su dependencia
  JEFE_DEPENDENCIA // además reparte dentro de su dependencia
  ADMIN_ARCHIVO // administra TRD/CCD, dependencias y ve todo
}

// Disposición final de una subserie documental (TRD) — Acuerdo 004/2019 AGN.
enum DisposicionFinal {
  CONSERVACION_TOTAL
  ELIMINACION
  SELECCION
  MICROFILMACION_DIGITALIZACION
}

enum TipoComunicacion {
  RECIBIDA // entra a la entidad
  ENVIADA // sale de la entidad (Fase 2)
  INTERNA // memorando entre dependencias (Fase 2)
}

enum EstadoComunicacion {
  RADICADA // recién radicada en ventanilla
  EN_REPARTO // pendiente de distribuir
  ASIGNADA // distribuida a dependencia/funcionario
  EN_TRAMITE // en gestión
  INFORMACION_ADICIONAL_REQUERIDA // término de ley suspendido (Art. 17 CPACA) hasta que el peticionario responda
  RESPONDIDA
  ARCHIVADA
  ANULADA // anulada con justificación (no se borra: queda trazada)
}

enum OrigenComunicacion {
  VENTANILLA // radicada por un operador
  WEB_PQRSD // formulario público (Fase 3)
  MIGRACION_COR // importada del Oracle legado (Fase 4)
  CORREO_ELECTRONICO
  OTRO
}

// Clasificación PQRSD (Ley 1755/2015, que modificó el Título II del CPACA — Ley
// 1437/2011). El término de respuesta depende del tipo, no es uniforme.
enum TipoPQRSD {
  PETICION_GENERAL // interés general o particular — 15 días hábiles
  PETICION_DOCUMENTOS // copia/consulta de documentos — 10 días hábiles
  CONSULTA // 30 días hábiles
  QUEJA // 15 días hábiles
  RECLAMO // 15 días hábiles
  SUGERENCIA // 15 días hábiles
  DENUNCIA // 15 días hábiles (puede derivar a control interno disciplinario)
}

enum MedioComunicacion {
  FISICO
  CORREO_ELECTRONICO
  WEB
  FAX
  PRESENCIAL
  TELEFONICO
  OTRO
}

// Niveles de acceso a la información (Ley 1712/2014 de Transparencia, arts. 6/18/19):
// toda información es PÚBLICA por defecto; CLASIFICADA protege derechos particulares
// (privacidad, datos personales); RESERVADA protege un interés público (seguridad,
// salud pública, etc.). Clasificar/reservar exige fundamento legal por escrito — de
// ahí el campo `fundamentoNivelAcceso`, obligatorio salvo para PUBLICA.
enum NivelAccesoInformacion {
  PUBLICA
  CLASIFICADA
  RESERVADA
}

// Acciones registradas en la bitácora inalterable (incluye LEE y EXPORTA, que
// la auditoría de cuenta RegistroAuditoria no captura).
enum AccionAuditoriaDoc {
  CREA
  LEE
  MODIFICA
  EXPORTA
  ELIMINA
  DISTRIBUYE
  FIRMA
  CLASIFICA
  ARCHIVA
  ANULA
  SUSPENDE // suspende el término de ley (Art. 17 CPACA)
  REACTIVA
  TRANSFIERE // pasa del archivo de gestión al archivo central
  DISPONE // ejecuta la disposición final (conserva/elimina/selecciona/microfilma)
  ACCESO_DENEGADO // MoReq 6.9: alguien sin permiso intentó entrar al módulo
  APLAZA // aplaza una disposición final ya vencida (MoReq 2.11), distinto de SUSPENDE (término de ley)
  RESPONDE // el funcionario asignado guarda/edita el borrador de respuesta de una RECIBIDA
  DESPACHA // la ventanilla de salida registra el envío efectivo (correo/físico) del oficio de salida — cierra el ciclo
  DEVUELVE_REPARTO // el funcionario al que se le repartió una recibida la devuelve a la ventanilla con motivo (no le corresponde)
  RETIRA_DOCUMENTO // se retira del índice de un expediente ABIERTO un archivo subido por error, con motivo (no se borra la fila ni el archivo)
  PRESTA // presta un expediente documental a un funcionario
  DEVUELVE // registra la devolución de un expediente prestado
  REABRE // reabre un expediente documental cerrado (MoReq 1.14), con motivo obligatorio
  CARGA_FALLIDA // MoReq 4.6: un intento de agregar un documento a un expediente fue rechazado (validación), para poder reportarlo
  ERROR_EJECUCION // MoReq 6.11: una operación falló a mitad de camino (excepción no controlada en una acción del módulo), para poder identificarla en la bitácora
  FLUJO // MoReq cap. 7: inicio, avance o cierre de un flujo de trabajo sobre una comunicación
}

// Organigrama de la CDMB (dependencias/oficinas). Jerárquico vía parentId.
// Fase 1 se siembra con una estructura mínima derivada de los cargos reales,
// editable desde el admin.
model Dependencia {
  id                   String   @id @default(cuid())
  codigo               String   @unique
  nombre               String
  parentId             String?
  nivel                Int      @default(0)
  responsableUsuarioId String?
  activo               Boolean  @default(true)
  orden                Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  parent      Dependencia?      @relation("DependenciaJerarquia", fields: [parentId], references: [id])
  hijos       Dependencia[]     @relation("DependenciaJerarquia")
  responsable Usuario?          @relation("DependenciaResponsable", fields: [responsableUsuarioId], references: [id])
  usuarios    Usuario[]         @relation("UsuarioDependencia")
  series      SerieDocumental[]

  comunicacionesDestino   Comunicacion[]         @relation("ComunicacionDependenciaDestino")
  comunicacionesOrigen    Comunicacion[]         @relation("ComunicacionDependenciaOrigen")
  distribuciones          Distribucion[]
  expedientesDocumentales ExpedienteDocumental[]
  pasosFlujo              PasoFlujo[]            @relation("PasoFlujoDependencia")

  @@index([parentId])
}

// Serie documental (TRD/CCD). Versionada: se pueden tener la TRD anterior y la
// nueva a la vez (vigenteDesde/Hasta) para migrar clasificaciones entre versiones.
model SerieDocumental {
  id                      String                  @id @default(cuid())
  codigo                  String
  nombre                  String
  descripcion             String?                 @db.Text
  dependenciaId           String?
  version                 String                  @default("1")
  vigenteDesde            DateTime                @default(now())
  vigenteHasta            DateTime?
  activo                  Boolean                 @default(true)
  // MoReq 1.46: criterio de ordenación de los documentos dentro de un expediente
  // de esta serie. El número de índice (ordenIndice) que respalda el hash firmado
  // NO cambia — esto solo controla el orden en que se VE la lista.
  criterioOrdenExpediente CriterioOrdenExpediente @default(FECHA_DOCUMENTO)
  // MoReq 2.6: desde cuándo cuenta la retención de lo clasificado en esta serie —
  // desde la radicación/creación (por defecto) o desde el cierre del expediente
  // donde quede archivado.
  retencionDesde          RetencionDesde          @default(RADICACION)
  // MoReq 1.43: si está, un expediente de esta serie que supere esta cantidad de
  // folios se divide en tomos (Tomo 1 de N, 2 de N…) en el FUID y el índice.
  maxFoliosPorTomo        Int?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  dependencia             Dependencia?           @relation(fields: [dependenciaId], references: [id])
  subseries               SubserieDocumental[]
  comunicaciones          Comunicacion[]
  expedientesDocumentales ExpedienteDocumental[]
  camposMetadato          CampoMetadato[]

  // El código de serie NO es único por sí solo: es una categoría universal
  // (ej. "20 ACTAS") que CADA dependencia produce por su cuenta, con sus
  // propias subseries y tiempos de retención — así es la TRD real de la CDMB.
  @@unique([dependenciaId, codigo, version])
  @@index([dependenciaId])
}

model SubserieDocumental {
  id                    String             @id @default(cuid())
  serieId               String
  codigo                String
  nombre                String
  retencionGestionAnios Int                @default(0)
  retencionCentralAnios Int                @default(0)
  // Varias a la vez son el caso REAL más común en la TRD de la CDMB (ej.
  // conservación total + microfilmación/digitalización juntas) — nunca fue un
  // valor único en la práctica, por eso es un arreglo y no un enum solo.
  disposicionesFinal    DisposicionFinal[]
  procedimiento         String?            @db.Text
  activo                Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  serie                   SerieDocumental        @relation(fields: [serieId], references: [id], onDelete: Cascade)
  comunicaciones          Comunicacion[]
  tiposDocumentales       TipoDocumental[]
  expedientesDocumentales ExpedienteDocumental[]

  @@unique([serieId, codigo])
  @@index([serieId])
}

enum CriterioOrdenExpediente {
  FECHA_DOCUMENTO // por la fecha del trámite/documento (Acuerdo 001/2024 AGN, orden natural)
  FECHA_INCORPORACION // por el orden real de incorporación al índice
  NOMBRE // alfabético por nombre de archivo
}

enum RetencionDesde {
  RADICACION // la retención cuenta desde la radicación/creación de cada documento (por defecto)
  CIERRE_EXPEDIENTE // cuenta desde el cierre del expediente donde quede archivado
}

enum TipoCampoMetadato {
  TEXTO
  NUMERO
  FECHA
  LISTA // una opción de `opciones`
  BOOLEANO
}

enum AmbitoCampoMetadato {
  COMUNICACION
  EXPEDIENTE
  AMBOS
}

// Campos de metadato adicionales que un administrador de archivo define desde la
// interfaz (MoReq 5.1/5.2): amplían la ficha de una comunicación o un expediente
// más allá del esquema fijo. Si `serieId` está puesto, el campo solo aparece para
// lo clasificado en esa serie y su `valorPorDefecto` se hereda (MoReq 5.3). Los
// valores se guardan en `Comunicacion.metadatos` / `ExpedienteDocumental.metadatos`
// (Json: { [clave]: valor }).
model CampoMetadato {
  id              String              @id @default(cuid())
  clave           String              @unique // slug estable, ej. "numero_predio"
  nombre          String // etiqueta visible
  ayuda           String?
  tipo            TipoCampoMetadato   @default(TEXTO)
  opciones        String[]            @default([]) // solo para tipo LISTA
  obligatorio     Boolean             @default(false)
  ambito          AmbitoCampoMetadato @default(AMBOS)
  serieId         String? // si está: solo aplica a esa serie y hereda su valorPorDefecto
  valorPorDefecto String?
  activo          Boolean             @default(true)
  orden           Int                 @default(0)
  createdAt       DateTime            @default(now())

  serie SerieDocumental? @relation(fields: [serieId], references: [id])

  @@index([serieId])
}

// Plantillas de documentos (MoReq 3.30/3.31): cuerpos y asuntos preescritos que
// un administrador de archivo crea y mantiene, y que un funcionario carga al
// redactar un oficio, un memorando, una respuesta o la descripción de un
// expediente. Solo texto plano — el cuerpo firmado del proyecto es texto, no hay
// editor enriquecido. El cuerpo/asunto puede traer marcadores tipo [FECHA] o
// [DESTINATARIO] que se rellenan solos al cargar la plantilla (ver src/lib/plantillas.ts).
model PlantillaDocumento {
  id          String          @id @default(cuid())
  nombre      String
  descripcion String?         @db.Text
  categoria   String? // agrupa la lista cuando hay muchas (opcional)
  asunto      String? // plantilla del asunto, opcional (se carga junto con el cuerpo)
  cuerpo      String          @db.Text
  ambito      AmbitoPlantilla @default(AMBAS)
  vecesUsada  Int             @default(0) // se incrementa cada vez que alguien la carga en un formulario
  activo      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// Vocabulario controlado (MoReq 1.17/5.5): lista normalizada de términos que un
// administrador de archivo mantiene y con la que se etiquetan comunicaciones y
// expedientes — la palabra clave que se guarda debe pertenecer a esta lista, no
// es texto libre.
model TerminoControlado {
  id        String   @id @default(cuid())
  termino   String   @unique
  categoria String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum AmbitoPlantilla {
  ENVIADA
  INTERNA
  RESPUESTA
  EXPEDIENTE // descripción de un expediente documental
  AMBAS // cualquier oficio/memorando/respuesta (no aplica a EXPEDIENTE)
}

// Tercer nivel de la TRD (Serie > Subserie > Tipo documental): qué documentos
// concretos se esperan dentro de una subserie (ej. "Acta de reunión" dentro de
// la subserie "Actas de Comité Directivo"). Solo referencial/descriptivo por
// ahora (MoReq 1.42) — no se exige seleccionar uno al radicar.
model TipoDocumental {
  id                 String  @id @default(cuid())
  subserieId         String
  nombre             String
  soportePapel       Boolean @default(false)
  soporteElectronico Boolean @default(false)

  subserie          SubserieDocumental @relation(fields: [subserieId], references: [id], onDelete: Cascade)
  documentosArchivo DocumentoArchivo[]

  @@index([subserieId])
}

// Secuencia de radicación ATÓMICA e inalterable — una fila por (serie, año).
// El consecutivo se obtiene con un UPDATE ... { increment: 1 } sobre esta fila
// (row-lock), NO con un COUNT(*) como en src/lib/expedientes.ts (que es
// race-prone). Ver src/lib/radicado.ts.
model ConsecutivoRadicado {
  id           String   @id @default(cuid())
  serie        String // "R" recibida, "E" enviada, "I" interna
  anio         Int
  ultimoNumero Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([serie, anio])
}

// Comunicación oficial radicada. Fase 1 usa tipo RECIBIDA; ENVIADA/INTERNA en Fase 2.
model Comunicacion {
  id              String             @id @default(cuid())
  tipo            TipoComunicacion
  radicado        String             @unique // ej. CDMB-R-2026-000123
  anio            Int
  fechaRadicacion DateTime           @default(now())
  medio           MedioComunicacion?
  origen          OrigenComunicacion @default(VENTANILLA)
  estado          EstadoComunicacion @default(RADICADA)

  asunto            String  @db.Text
  contenido         String? @db.Text // cuerpo del oficio/memorando (ENVIADA/INTERNA); en RECIBIDA solo se usa para la narración de una PQRSD (el resto llega como documento adjunto)
  folios            Int     @default(1)
  anexosDescripcion String?

  // PQRSD (Fase 3, Ley 1755/2015): solo aplica a RECIBIDA. `terminoDiasHabiles`
  // queda fijado al radicar (según el tipo) para poder recalcular el vencimiento
  // si el término se suspende y se reactiva (Art. 17 CPACA) sin tener que volver
  // a mirar la tabla de términos por tipo más adelante.
  tipoPqrsd              TipoPQRSD?
  terminoDiasHabiles     Int?
  fechaSuspensionTermino DateTime?
  // MoReq 7.18: motivo por el que se detuvo el trámite. Para una PQRSD es el
  // Art. 17 CPACA (falta información del peticionario); para cualquier otra
  // recibida es una pausa administrativa con su justificación.
  motivoSuspension       String?    @db.Text

  // Anulación (Ley 594/2000: nunca se borra un radicado, se anula con motivo y queda trazado).
  motivoAnulacion String? @db.Text

  // Tercero (remitente si RECIBIDA / destinatario si ENVIADA): FK opcional al
  // maestro Solicitante + snapshot "foto del momento" (mismo patrón que Expediente).
  terceroId                 String?
  terceroTipo               TipoSolicitante?
  terceroTipoIdentificacion String? // CC, CE, NIT, PA, TI, ANONIMO (texto libre; no hay enum de tipo-id en el proyecto)
  terceroIdentificacion     String?
  terceroNombre             String?
  terceroEmail              String?
  terceroTelefono           String?
  terceroDireccion          String?
  terceroMunicipio          String?
  terceroDepartamento       String? // solo si el municipio está fuera de la jurisdicción y se escribió a mano

  dependenciaOrigenId    String? // quién envía (ENVIADA/INTERNA) — la dependencia que redacta
  dependenciaDestinoId   String? // a qué dependencia de la CDMB va dirigida (RECIBIDA) o destino (INTERNA)
  serieId                String? // clasificación TRD
  subserieId             String?
  expedienteId           String? // archivada dentro de un expediente de Trámites 2.0 (unificación)
  expedienteDocumentalId String? // archivada dentro de un ExpedienteDocumental (archivo general, no un trámite)
  vitalRelacionado       String? // idVital relacionado, si aplica (columna VITAL_REC del legado)
  respondeAId            String? // ENVIADA que responde a una comunicación RECIBIDA — enlaza el ciclo completo

  fechaVencimiento DateTime? // término de ley (se calcula en Fase 3 con días hábiles)
  radicadoPorId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Disposición final (Fase 4, Acuerdo 004/2019 AGN): retención contada desde
  // fechaRadicacion usando retencionGestionAnios/retencionCentralAnios de la
  // subserie. La eliminación/selección exige un acta (ActaEliminacion); la
  // conservación total/microfilmación no destruyen nada en este sistema, solo
  // marcan fechaDisposicionFinal.
  // Palabras clave del vocabulario controlado (MoReq 5.5) — cada valor debe existir
  // como TerminoControlado activo al momento de guardarse (se valida en el dominio).
  palabrasClave String[] @default([])
  // MoReq 5.1/5.6: valores de los campos de metadato adicionales definidos por el
  // administrador ({ [CampoMetadato.clave]: valor }). Validado contra CampoMetadato.
  metadatos     Json?

  transferidaCentralEn         DateTime?
  // MoReq 2.17: una transferencia al archivo central se "conserva" (no se puede
  // ejecutar disposición final sobre ella) hasta que el archivo central confirma
  // que recibió el documento y el proceso concluyó. Sin confirmar, sigue
  // apareciendo en el panel de transferencias pendientes de confirmar.
  transferenciaConfirmadaEn    DateTime?
  transferenciaConfirmadaPorId String?
  fechaDisposicionFinal        DateTime?
  actaEliminacionId            String?

  // Aplazamiento de la disposición final ya vencida (MoReq 2.11) — con motivo
  // auditado, ej. mientras dura un proceso judicial o disciplinario sobre lo
  // que contiene. Mientras disposicionAplazadaHasta sea futura, no aparece
  // como pendiente de disposición aunque ya haya cumplido su retención.
  disposicionAplazadaHasta DateTime?
  motivoAplazamiento       String?   @db.Text

  // Nivel de acceso a la información (Ley 1712/2014) — ver enum NivelAccesoInformacion.
  nivelAcceso           NivelAccesoInformacion @default(PUBLICA)
  fundamentoNivelAcceso String?                @db.Text

  // Respuesta del funcionario asignado (RECIBIDA) — un borrador previo a que
  // ventanilla/gestión documental la radique formalmente como ENVIADA con
  // consecutivo y firma (respondeAId). Sin esto, solo quien puede radicar
  // (ventanilla/admin de archivo) tenía forma de dejar constancia de una
  // respuesta — un funcionario con acceso solo de reparto no tenía dónde
  // escribirla, aunque la comunicación ya estuviera asignada a su cargo.
  respuestaTexto String?   @db.Text
  respuestaPorId String?
  respuestaEn    DateTime?

  // Despacho efectivo del oficio de salida (ENVIADA) — la ventanilla de salida /
  // gestión documental registra que el oficio ya radicado y firmado SE ENVIÓ de
  // verdad al destinatario (correo, físico, mensajería). Este paso, no la mera
  // radicación, es el que cierra el ciclo de la recibida a la que responde: un
  // funcionario redacta el borrador, pero el envío efectivo es responsabilidad de
  // la ventanilla (una firma + un radicado no significan "ya salió").
  despachadaEn        DateTime?
  despachadaPorId     String?
  despachoMedio       String? // "CORREO_ELECTRONICO" | "FISICO" | "MENSAJERIA" | "PERSONAL"
  despachoDestino     String? // correo o dirección a donde efectivamente se envió (snapshot)
  despachoObservacion String?   @db.Text

  tercero                    Solicitante?          @relation(fields: [terceroId], references: [id])
  dependenciaOrigen          Dependencia?          @relation("ComunicacionDependenciaOrigen", fields: [dependenciaOrigenId], references: [id])
  dependenciaDestino         Dependencia?          @relation("ComunicacionDependenciaDestino", fields: [dependenciaDestinoId], references: [id])
  serie                      SerieDocumental?      @relation(fields: [serieId], references: [id])
  subserie                   SubserieDocumental?   @relation(fields: [subserieId], references: [id])
  expediente                 Expediente?           @relation(fields: [expedienteId], references: [id])
  expedienteDocumental       ExpedienteDocumental? @relation(fields: [expedienteDocumentalId], references: [id])
  radicadoPor                Usuario?              @relation("ComunicacionRadicadaPor", fields: [radicadoPorId], references: [id])
  respuestaPor               Usuario?              @relation("ComunicacionRespuestaPor", fields: [respuestaPorId], references: [id])
  despachadaPor              Usuario?              @relation("ComunicacionDespachadaPor", fields: [despachadaPorId], references: [id])
  transferenciaConfirmadaPor Usuario?              @relation("ComunicacionTransferenciaConfirmadaPor", fields: [transferenciaConfirmadaPorId], references: [id])
  respondeA                  Comunicacion?         @relation("ComunicacionRespuesta", fields: [respondeAId], references: [id])
  respuestas                 Comunicacion[]        @relation("ComunicacionRespuesta")
  actaEliminacion            ActaEliminacion?      @relation(fields: [actaEliminacionId], references: [id])

  documentos      ComunicacionDocumento[]
  distribuciones  Distribucion[]
  firmas          Firma[]
  instanciasFlujo InstanciaFlujo[]

  @@index([tipo])
  @@index([anio])
  @@index([dependenciaOrigenId])
  @@index([respondeAId])
  @@index([estado])
  @@index([fechaRadicacion])
  @@index([dependenciaDestinoId])
  @@index([expedienteId])
  @@index([expedienteDocumentalId])
  @@index([fechaVencimiento])
  @@index([actaEliminacionId])
}

// Acta formal que autoriza eliminar o seleccionar (eliminación parcial) un lote de
// comunicaciones ya vencidas en su retención (Acuerdo 004/2019 AGN). El original se
// destruye, pero el registro del sistema (radicado, asunto, fechas) se conserva
// como evidencia de qué existió y bajo qué autorización se dispuso — nunca se borra
// la fila de Comunicacion en sí.
model ActaEliminacion {
  id            String   @id @default(cuid())
  numero        Int      @unique @default(autoincrement())
  fecha         DateTime @default(now())
  responsable   String // nombre de quien aprueba (comité de archivo), texto libre
  motivacion    String?  @db.Text
  aprobadaPorId String?
  createdAt     DateTime @default(now())

  aprobadaPor    Usuario?       @relation("ActaEliminacionAprobadaPor", fields: [aprobadaPorId], references: [id])
  comunicaciones Comunicacion[]

  @@index([fecha])
}

// Adjunto de una comunicación. Igual patrón que ExpedienteDocumento + hash
// SHA-256 del contenido (integridad/preservación, MoReq).
model ComunicacionDocumento {
  id             String   @id @default(cuid())
  comunicacionId String
  nombre         String
  descripcion    String?
  storagePath    String
  mimeType       String
  tamanoBytes    Int
  hashSha256     String? // integridad del archivo tal como se recibió
  subidoPorId    String?
  createdAt      DateTime @default(now())
  // true = lo adjuntó el funcionario asignado como parte de su respuesta (PDF/Word ya
  // redactado), no es un anexo de la comunicación original. Se muestra aparte en el
  // detalle y, al radicar la respuesta como oficio de salida, se traslada también a esa
  // nueva Comunicacion (misma ruta de Storage, sin volver a subir el archivo).
  esRespuesta    Boolean  @default(false)

  comunicacion Comunicacion @relation(fields: [comunicacionId], references: [id], onDelete: Cascade)
  subidoPor    Usuario?     @relation("ComunicacionDocumentoSubidoPor", fields: [subidoPorId], references: [id])

  @@index([comunicacionId])
}

// Distribución/reparto de una comunicación a una dependencia y/o funcionario.
model Distribucion {
  id              String    @id @default(cuid())
  comunicacionId  String
  dependenciaId   String?
  usuarioId       String?
  instrucciones   String?   @db.Text
  termino         Int? // días para responder (se convierte a fechaVencimiento en Fase 3)
  fechaAsignacion DateTime  @default(now())
  fechaAcuse      DateTime? // cuándo el destinatario dio acuse de recibido
  asignadoPorId   String?
  // Reparto vigente vs. historial: un reparto se puede hacer a VARIOS funcionarios a
  // la vez (un lote), y un reparto posterior desactiva el anterior salvo que se pida
  // "sumar". `activa` = sigue siendo un destinatario actual de la comunicación.
  activa          Boolean   @default(true)
  // Devolución del reparto a la ventanilla: el funcionario al que se le repartió
  // puede devolverlo indicando por qué no le corresponde — salvo que falten 3 días
  // hábiles o menos para el vencimiento del término de ley. Al devolver, la
  // distribución deja de estar activa y la comunicación vuelve a EN_REPARTO.
  devueltaEn      DateTime?
  motivoDevolucion String?  @db.Text
  createdAt       DateTime  @default(now())

  comunicacion Comunicacion @relation(fields: [comunicacionId], references: [id], onDelete: Cascade)
  dependencia  Dependencia? @relation(fields: [dependenciaId], references: [id])
  usuario      Usuario?     @relation("DistribucionUsuario", fields: [usuarioId], references: [id])
  asignadoPor  Usuario?     @relation("DistribucionAsignadoPor", fields: [asignadoPorId], references: [id])

  @@index([comunicacionId])
  @@index([dependenciaId])
  @@index([usuarioId])
}

// Firma electrónica con hash (Ley 527/1999 + Decreto 2364/2012): identidad del
// firmante + marca de tiempo + hash SHA-256 del contenido firmado. No es firma
// digital con certificado de CA. Usada en Fase 2 (salientes/memorandos).
model Firma {
  id             String   @id @default(cuid())
  usuarioId      String
  fechaHora      DateTime @default(now())
  hashContenido  String
  tipo           String   @default("ELECTRONICA_HASH")
  comunicacionId String?
  documentoId    String?
  ip             String?

  // Proveedor y formato de la firma (abstracción para enchufar una CA acreditada
  // después — ver src/lib/firma-proveedor.ts). Estampado cronológico: `selloTiempoEn`
  // es la fecha atestiguada, `selloTiempoFuente` de dónde viene (bitácora interna o
  // URL de una TSA RFC-3161), `selloTiempoToken` el token verificable si hubo TSA.
  proveedor         String    @default("interno")
  formato           String    @default("hash-sha256")
  selloTiempoEn     DateTime?
  selloTiempoFuente String?
  selloTiempoToken  String?

  usuario      Usuario       @relation("FirmaUsuario", fields: [usuarioId], references: [id])
  comunicacion Comunicacion? @relation(fields: [comunicacionId], references: [id])

  @@index([comunicacionId])
  @@index([usuarioId])
}

enum EstadoExpedienteDocumental {
  ABIERTO
  CERRADO
}

// Expediente electrónico de archivo (Art. 4.3.2 Acuerdo 001/2024 AGN): la unidad
// documental que agrupa TODOS los documentos de un mismo trámite, actuación o
// procedimiento de una dependencia — a diferencia de Expediente (arriba), que es
// específico de un trámite ambiental de Trámites 2.0, y de Comunicacion, que es
// específica de un radicado de correspondencia. Un funcionario de CUALQUIER
// dependencia puede abrir uno y subirle documentos directamente sin que tengan
// que llegar por correspondencia — es el archivo de gestión del día a día de
// cada área (contratos, actas internas, historias laborales, etc.). También se
// le pueden archivar comunicaciones ya radicadas (mismo patrón que
// Comunicacion.expedienteId, pero hacia este modelo).
model ExpedienteDocumental {
  id          String                     @id @default(cuid())
  numero      String                     @unique // ej. CDMB-X-2026-000001 (mismo consecutivo atómico que Comunicacion, serie "X")
  asunto      String                     @db.Text
  descripcion String?                    @db.Text
  estado      EstadoExpedienteDocumental @default(ABIERTO)

  dependenciaId String
  serieId       String?
  subserieId    String?

  creadoPorId   String
  fechaApertura DateTime  @default(now())
  fechaCierre   DateTime?
  cerradoPorId  String?
  // Hash del índice electrónico al cerrar (Art. 4.3.2.2-4 AGN: "firma del índice
  // electrónico"). Firma con hash, mismo criterio que Firma/AuditoriaDoc — no
  // digital con certificado. Cubre el orden y el hash de cada documento: si algo
  // cambia después de cerrado, deja de coincidir.
  indiceHash    String?

  // Nivel de acceso a la información (Ley 1712/2014) — ver enum NivelAccesoInformacion.
  nivelAcceso           NivelAccesoInformacion @default(PUBLICA)
  fundamentoNivelAcceso String?                @db.Text

  // Palabras clave del vocabulario controlado (MoReq 5.5).
  palabrasClave String[] @default([])
  // MoReq 5.1/5.6: campos de metadato adicionales (ver CampoMetadato).
  metadatos     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dependencia Dependencia         @relation(fields: [dependenciaId], references: [id])
  serie       SerieDocumental?    @relation(fields: [serieId], references: [id])
  subserie    SubserieDocumental? @relation(fields: [subserieId], references: [id])
  creadoPor   Usuario             @relation("ExpedienteDocumentalCreadoPor", fields: [creadoPorId], references: [id])
  cerradoPor  Usuario?            @relation("ExpedienteDocumentalCerradoPor", fields: [cerradoPorId], references: [id])

  documentos     DocumentoArchivo[]
  comunicaciones Comunicacion[]
  prestamos      PrestamoExpediente[]

  @@index([dependenciaId])
  @@index([serieId])
  @@index([estado])
}

// Préstamo/consulta de un expediente por un funcionario — quién lo tiene actualmente "afuera" (aunque sea
// 100% electrónico, el archivo sigue necesitando saber quién está trabajando con qué expediente en un
// momento dado, igual que cualquier SGDEA). No bloquea nada del expediente (subir/editar/cerrar siguen
// gobernados solo por dependencia/rol) — es únicamente el registro de quién lo tiene y desde cuándo.
model PrestamoExpediente {
  id                      String    @id @default(cuid())
  expedienteDocumentalId  String
  prestadoAId             String
  prestadoPorId           String
  motivo                  String?   @db.Text
  fechaPrestamo           DateTime  @default(now())
  fechaDevolucionEsperada DateTime?
  fechaDevolucionReal     DateTime?

  expedienteDocumental ExpedienteDocumental @relation(fields: [expedienteDocumentalId], references: [id])
  prestadoA            Usuario              @relation("PrestamoPrestadoA", fields: [prestadoAId], references: [id])
  prestadoPor          Usuario              @relation("PrestamoPrestadoPor", fields: [prestadoPorId], references: [id])

  @@index([expedienteDocumentalId])
}

// Documento subido DIRECTAMENTE a un ExpedienteDocumental (no vía correspondencia).
// Mismo patrón que ComunicacionDocumento/ExpedienteDocumento: hash SHA-256 +
// storagePath en el bucket "documentos". `ordenIndice` es la posición dentro del
// índice electrónico del expediente (Art. 4.3.2.3 AGN: debe respetar el orden
// original y permitir reconstruir la secuencia completa).
model DocumentoArchivo {
  id                     String    @id @default(cuid())
  expedienteDocumentalId String
  ordenIndice            Int
  nombre                 String
  descripcion            String?
  storagePath            String
  mimeType               String
  tamanoBytes            Int
  hashSha256             String?
  subidoPorId            String
  createdAt              DateTime  @default(now())
  // Fecha propia del documento (de trámite) cuando es distinta de cuándo se subió — ej. un documento
  // antiguo que se digitaliza hoy. Si no se indica, se asume que coincide con createdAt (MoReq 1.45).
  fechaDocumento         DateTime?
  // Tipo documental (MoReq 1.42) — opcional, solo se puede elegir entre los tipos definidos en la TRD para
  // la subserie del expediente (si el expediente no tiene subserie clasificada, no hay nada que elegir).
  tipoDocumentalId       String?
  // Versionado (MoReq 3.9: "elegir cómo tratar un documento con varias versiones") — opcional: al subir un
  // documento se puede indicar que reemplaza a uno ya existente EN EL MISMO expediente, formando una cadena
  // de versiones (A reemplazado por B reemplazado por C...). Ninguna versión anterior se borra ni se oculta
  // — el índice electrónico sigue siendo append-only; esto solo agrega la relación entre versiones.
  reemplazaId            String?
  // Foliación (MoReq 1.19/1.51) — número de hojas/páginas que declara quien sube el documento (no se
  // detecta automáticamente: no hay librería de conteo de páginas de PDF en el proyecto, y buena parte del
  // archivo real no es PDF). Es la misma práctica manual de cualquier archivo físico al foliar; el índice
  // muestra el rango acumulado (ej. "Folios 6-12") a partir de este valor por documento, en el mismo orden
  // (ordenIndice) que respalda el hash del índice firmado. Los documentos previos a este campo quedan en 1
  // por defecto — no se puede reconstruir retroactivamente cuántas páginas tenían en realidad.
  numeroFolios           Int       @default(1)

  // Corrección en un expediente ABIERTO (Art. 4.3.2 Acuerdo 001/2024 AGN: el
  // expediente se conforma hasta el cierre; ahí se firma el índice). Se puede
  // corregir la metadata (nombre, tipo, folios, fecha) y RETIRAR del índice un
  // archivo subido por error — nunca se borra la fila ni el archivo del storage:
  // se marca con motivo y queda fuera del índice, del hash, del FUID y del PDF
  // consolidado, pero trazado en la bitácora (mismo principio que ANULADA en una
  // comunicación). Un expediente CERRADO ya no admite ninguna de las dos.
  retiradoEn             DateTime?
  retiradoPorId          String?
  motivoRetiro           String?   @db.Text

  expediente     ExpedienteDocumental @relation(fields: [expedienteDocumentalId], references: [id], onDelete: Cascade)
  subidoPor      Usuario              @relation("DocumentoArchivoSubidoPor", fields: [subidoPorId], references: [id])
  retiradoPor    Usuario?             @relation("DocumentoArchivoRetiradoPor", fields: [retiradoPorId], references: [id])
  tipoDocumental TipoDocumental?      @relation(fields: [tipoDocumentalId], references: [id])
  reemplaza      DocumentoArchivo?    @relation("DocumentoArchivoVersion", fields: [reemplazaId], references: [id], onDelete: SetNull)
  reemplazadoPor DocumentoArchivo[]   @relation("DocumentoArchivoVersion")

  @@index([expedienteDocumentalId])
}

// Bitácora inalterable con cadena de hash. Cada fila encadena su `hash` con el
// `hashAnterior` (hash de la fila previa por `secuencia`): alterar/borrar una
// fila rompe la cadena y `verificarCadena()` lo detecta. Registra también LEE y
// EXPORTA. Ver src/lib/auditoria-doc.ts.
model AuditoriaDoc {
  id           String             @id @default(cuid())
  secuencia    Int                @unique @default(autoincrement())
  entidad      String // "Comunicacion", "ComunicacionDocumento", ...
  entidadId    String
  accion       AccionAuditoriaDoc
  usuarioId    String?
  ip           String?
  userAgent    String?
  detalle      String?            @db.Text
  hashAnterior String?
  hash         String
  createdAt    DateTime           @default(now())

  // onDelete Restrict a propósito (el default de Prisma en una relación opcional sería
  // SetNull): un hard-delete de Usuario pondría usuarioId en NULL sin recalcular el hash
  // ya almacenado de cada fila que lo referencia — verificarCadena() la reportaría como
  // alterada (falso positivo). Restrict lo convierte en un error inmediato y explícito en
  // vez de una corrupción silenciosa del hash-chain. Ver [[feedback_limpieza_datos_prueba_auditoria]].
  usuario Usuario? @relation("AuditoriaDocUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([entidad, entidadId])
  @@index([usuarioId])
  @@index([createdAt])
}

// Límite de envíos públicos sin autenticación (formulario PQRSD, Fase 3). No hay
// CAPTCHA de terceros en el proyecto (exigiría una cuenta/API key externa) — este
// conteo por IP+ruta, combinado con honeypot y tiempo mínimo de llenado en el
// propio formulario, es la defensa contra abuso. Persistido en base (no en
// memoria): en Vercel cada invocación puede caer en una instancia distinta.
model IntentoEnvioPublico {
  id        String   @id @default(cuid())
  ip        String
  ruta      String
  createdAt DateTime @default(now())

  @@index([ip, ruta, createdAt])
}

// ============================================================================
// Flujos de trabajo electrónicos configurables (MoReq cap. 7). El administrador
// funcional arma el flujo (pasos + transiciones + a quién se asigna cada paso)
// desde la interfaz — NO están fijos en código. Un flujo es una plantilla; cada
// vez que se aplica a una comunicación nace una InstanciaFlujo que va avanzando
// de paso en paso, con constancia de quién hizo qué y cuándo.
// ============================================================================

enum TipoPasoFlujo {
  TAREA // trabajo de un responsable (redactar, revisar el expediente, etc.)
  REVISION // aprobar o devolver — normalmente tiene dos transiciones de salida
  DECISION // bifurca el flujo según la opción que elija el responsable
  FIN // cierra el flujo
}

enum AsignacionPaso {
  DEPENDENCIA_COMUNICACION // la dependencia de la comunicación (destino en recibidas/memorandos, origen en enviadas)
  DEPENDENCIA_FIJA // una dependencia concreta (dependenciaId del paso)
  CARGO // cualquier funcionario con un cargo (cargoClave del paso)
  RADICADOR // quien radicó la comunicación
  RESPONSABLE_PASO_ANTERIOR // quien completó el paso inmediatamente anterior
  MANUAL // se asigna a mano cuando el flujo llega a este paso
}

enum EstadoInstanciaFlujo {
  EN_CURSO
  COMPLETADO
  CANCELADO
}

model FlujoTrabajo {
  id                     String            @id @default(cuid())
  nombre                 String
  descripcion            String?           @db.Text
  aplicaA                TipoComunicacion? // null = cualquier tipo
  activo                 Boolean           @default(true)
  esPlantilla            Boolean           @default(false) // se creó desde las plantillas precargadas
  // MoReq 7.8: si tiene dependencias, solo un funcionario de una de ellas (o admin de
  // archivo) puede iniciar/avanzar este flujo. Vacío = cualquiera con permiso de operar flujos.
  dependenciasOperadoras String[]          @default([])
  creadoPorId            String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  pasos        PasoFlujo[]
  transiciones TransicionPaso[]
  instancias   InstanciaFlujo[]
  creadoPor    Usuario?         @relation("FlujoCreadoPor", fields: [creadoPorId], references: [id])

  @@index([activo])
}

model PasoFlujo {
  id             String         @id @default(cuid())
  flujoId        String
  orden          Int // 1 = paso inicial; también es el orden visual del diagrama
  nombre         String
  instrucciones  String?        @db.Text
  tipo           TipoPasoFlujo  @default(TAREA)
  asignacion     AsignacionPaso @default(DEPENDENCIA_COMUNICACION)
  dependenciaId  String? // si asignacion = DEPENDENCIA_FIJA
  cargoClave     String? // si asignacion = CARGO
  slaDiasHabiles Int? // término sugerido para completar este paso
  // Posición del nodo en el lienzo del editor visual (React Flow). null = sin colocar
  // todavía → el lienzo lo ubica automáticamente por `orden`.
  posX           Float?
  posY           Float?

  flujo             FlujoTrabajo     @relation(fields: [flujoId], references: [id], onDelete: Cascade)
  dependencia       Dependencia?     @relation("PasoFlujoDependencia", fields: [dependenciaId], references: [id])
  transiciones      TransicionPaso[] @relation("TransicionDesde")
  transicionesHacia TransicionPaso[] @relation("TransicionHacia")
  instanciasAqui    InstanciaFlujo[] @relation("InstanciaPasoActual")
  ejecuciones       PasoEjecutado[]

  @@index([flujoId])
}

model TransicionPaso {
  id          String @id @default(cuid())
  flujoId     String
  desdePasoId String
  haciaPasoId String
  etiqueta    String @default("Continuar") // "Aprobado", "Devolver para ajustes", etc.
  orden       Int    @default(0)

  flujo FlujoTrabajo @relation(fields: [flujoId], references: [id], onDelete: Cascade)
  desde PasoFlujo    @relation("TransicionDesde", fields: [desdePasoId], references: [id], onDelete: Cascade)
  hacia PasoFlujo    @relation("TransicionHacia", fields: [haciaPasoId], references: [id], onDelete: Cascade)

  @@index([flujoId])
  @@index([desdePasoId])
}

model InstanciaFlujo {
  id              String               @id @default(cuid())
  flujoId         String
  comunicacionId  String
  estado          EstadoInstanciaFlujo @default(EN_CURSO)
  pasoActualId    String?
  // Cuándo se entró al paso actual — base para el vencimiento del término sugerido
  // (slaDiasHabiles) del paso. Se actualiza en cada avance.
  pasoActualDesde DateTime?
  iniciadoPorId   String?
  iniciadoEn      DateTime             @default(now())
  finalizadoEn    DateTime?

  flujo        FlujoTrabajo    @relation(fields: [flujoId], references: [id])
  comunicacion Comunicacion    @relation(fields: [comunicacionId], references: [id], onDelete: Cascade)
  pasoActual   PasoFlujo?      @relation("InstanciaPasoActual", fields: [pasoActualId], references: [id])
  iniciadoPor  Usuario?        @relation("InstanciaFlujoIniciadoPor", fields: [iniciadoPorId], references: [id])
  ejecuciones  PasoEjecutado[]

  @@index([comunicacionId])
  @@index([estado])
}

model PasoEjecutado {
  id            String   @id @default(cuid())
  instanciaId   String
  pasoId        String
  resultado     String? // etiqueta de la transición elegida al completar
  comentario    String?  @db.Text
  responsableId String?
  completadoEn  DateTime @default(now())

  instancia   InstanciaFlujo @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  paso        PasoFlujo      @relation(fields: [pasoId], references: [id])
  responsable Usuario?       @relation("PasoEjecutadoResponsable", fields: [responsableId], references: [id])

  @@index([instanciaId])
}
