generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Configuración de apariencia (logos del header/footer institucional) — fila
// única "singleton", igual patrón que el proyecto Negocios Verdes
// (configuracion_sitio): logo propio + los 3 sellos oficiales de gov.co.
// ---------------------------------------------------------------------------

model ConfiguracionSitio {
  id               String   @id @default("singleton")
  logoUrl          String? // logo de la CDMB, header + footer
  logoPath         String?
  logoGovcoUrl     String? // franja azul superior
  logoGovcoPath    String?
  logoColombiaUrl  String? // franja azul del footer
  logoColombiaPath String?
  logoPotenciaUrl  String? // "Colombia Potencia de la Vida", franja del footer
  logoPotenciaPath String?
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Usuarios internos (funcionarios CDMB)
// ---------------------------------------------------------------------------

enum RolUsuario {
  ADMIN
  FUNCIONARIO
}

/**
 * Cargo real dentro de la CDMB (Subdirector SEYCA, Profesional en Derecho, etc.) —
 * es distinto del RolUsuario (que es el permiso dentro de la app). El cargo es
 * "quién es" el funcionario en la organización; se usa para resaltar qué pasos
 * de un trámite le corresponden. Catálogo fijo, sembrado en prisma/seed.ts a
 * partir de los "responsables" reales de los 30 procedimientos — ver
 * src/lib/cargos.ts para las palabras clave de coincidencia con cada paso.
 */
model Cargo {
  id      String    @id @default(cuid())
  nombre  String    @unique
  orden   Int       @default(0)
  usuarios Usuario[]
  expedientesAsignacion Expediente[] @relation("ExpedienteCargosAsignados")
}

model Usuario {
  id           String     @id @default(cuid())
  email        String     @unique
  nombre       String
  passwordHash String
  rol          RolUsuario @default(FUNCIONARIO)
  cargoId      String?
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  cargo                Cargo?            @relation(fields: [cargoId], references: [id])
  expedientesCreados   Expediente[]      @relation("CreadoPor")
  expedientesAsignados Expediente[]      @relation("ResponsableActual")
  expedientesAsignacion Expediente[]     @relation("ExpedienteUsuariosAsignados")
  documentos           ExpedienteDocumento[]
  eventos              ExpedienteEvento[]
  registrosAuditoria   RegistroAuditoria[]
}

// ---------------------------------------------------------------------------
// Auditoría del sistema (distinta de ExpedienteEvento, que es la bitácora de
// UN expediente) — acciones a nivel de cuenta: logins, gestión de usuarios,
// cambios de configuración. Solo lectura desde /auditoria (solo ADMIN).
// ---------------------------------------------------------------------------

enum TipoAuditoria {
  LOGIN_EXITOSO
  LOGIN_FALLIDO
  USUARIO_CREADO
  USUARIO_ACTIVADO
  USUARIO_DESACTIVADO
  CONFIGURACION_ACTUALIZADA
}

model RegistroAuditoria {
  id           String         @id @default(cuid())
  tipo         TipoAuditoria
  descripcion  String         @db.Text
  usuarioId    String? // quién hizo la acción; null si el login fallido no correspondía a ningún usuario real
  emailIntento String? // correo usado en un intento de login (exitoso o no), aunque no exista el usuario
  createdAt    DateTime       @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([tipo])
  @@index([usuarioId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Catálogo de trámites (datos de referencia, sembrados desde data/tramites/*.json)
// ---------------------------------------------------------------------------

model TramiteTipo {
  id                        String   @id @default(cuid())
  codigo                    String   @unique // ej. M-DA-PR05
  version                   String
  fecha                     DateTime
  proceso                   String
  nombre                    String
  nombreCompleto            String
  slug                      String   @unique
  archivoFuente             String
  objeto                    String   @db.Text
  resumen                   String?  @db.Text // frase natural "Este trámite..." para la UI (objeto es la redacción formal del PDF)
  alcance                   String   @db.Text
  autoridadResponsabilidad  String   @db.Text
  suitNumeros               String[] @default([]) // número(s) de ficha en el SUIT (Sistema Único de Información de Trámites), si está inscrito — algunos trámites tienen más de uno (ej. concesión de aguas superficiales + subterráneas por separado)
  activo                    Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  flujos              Flujo[]
  documentosRequeridos DocumentoRequeridoDefinicion[]
  expedientes         Expediente[]
}

model DocumentoRequeridoDefinicion {
  id            String  @id @default(cuid())
  tramiteTipoId String
  orden         Int
  nombre        String
  obligatorio   Boolean @default(true)
  notas         String?
  aplicaA       TipoSolicitante? // null = aplica a cualquier solicitante; si no, solo es obligatorio para ese tipo (ej. "Certificado de Existencia y Representación Legal" solo para JURIDICA)

  tramiteTipo TramiteTipo @relation(fields: [tramiteTipoId], references: [id], onDelete: Cascade)

  @@index([tramiteTipoId])
}

model Flujo {
  id            String  @id @default(cuid())
  tramiteTipoId String
  codigo        String // inicio | renovacion | ...
  nombre        String
  esFlujoInicial Boolean @default(false)
  orden         Int     @default(0)
  suitNumero    String? // ficha del SUIT específica de ESTE flujo, cuando el SUIT registra cada modalidad por separado (ej. M-DA-PR21: "Concesión de Aguas Superficiales" y "Concesión de Aguas Subterráneas" son un solo procedimiento/PDF pero dos fichas SUIT distintas)
  resumen       String? @db.Text // frase natural de ESTE flujo, para cuando se ve enfocado en un solo flujo (?flujo=...) y no debe mencionar la otra modalidad

  tramiteTipo TramiteTipo    @relation(fields: [tramiteTipoId], references: [id], onDelete: Cascade)
  pasos       PasoDefinicion[]
  expedientes Expediente[]

  @@unique([tramiteTipoId, codigo])
}

model PasoDefinicion {
  id          String   @id @default(cuid())
  flujoId     String
  numero      Int
  titulo      String
  descripcion String   @db.Text
  responsables String[]
  documentos   String[]
  tiempo       String?
  tiempoDias   Int?
  esDecision   Boolean  @default(false)
  opciones     Json?

  flujo Flujo @relation(fields: [flujoId], references: [id], onDelete: Cascade)

  @@unique([flujoId, numero])
}

// ---------------------------------------------------------------------------
// Expedientes (instancias reales de un trámite gestionadas por la CDMB)
// ---------------------------------------------------------------------------

enum EstadoExpediente {
  RADICADO
  EN_TRAMITE
  INFORMACION_ADICIONAL_REQUERIDA
  SUSPENDIDO
  APROBADO
  NEGADO
  DESISTIDO
  ARCHIVADO
  RECHAZADO
}

enum TipoSolicitante {
  NATURAL
  JURIDICA
}

enum RegimenTributario {
  RESPONSABLE_IVA
  NO_RESPONSABLE_IVA
  SIMPLE_TRIBUTACION
  REGIMEN_ESPECIAL
  OTRO
}

enum ClaseSolicitud {
  NUEVA
  RENOVACION
}

/**
 * Registro maestro por NIT/cédula — antes cada Expediente guardaba su propia
 * copia de los datos del solicitante, sin nada que los conectara: la misma
 * empresa podía quedar escrita distinto en cada trámite, y no había forma de
 * preguntar "¿qué otros trámites tiene esta NIT con la CDMB?". Ahora, al
 * radicar, se busca por identificación — si ya existe se reutiliza (y se
 * actualizan los datos de contacto), si no existe se crea aquí.
 *
 * El régimen tributario y "gran contribuyente" NO son decorativos: la CDMB
 * a veces le paga a estos mismos terceros (o cobra estampillas), y el
 * régimen determina retenciones/beneficios — por eso se guardan aquí y no
 * en cada Expediente. A propósito no se replicó el formulario contable
 * completo del sistema viejo (clave contable, RUP, actividad económica...)
 * — eso vive en el sistema contable real de la CDMB, no en SINCA.
 *
 * `Expediente.solicitanteNombre/Identificacion/...` se mantienen aparte
 * (no se borran): son la foto de cómo era el solicitante EN ESE MOMENTO,
 * que para un trámite regulatorio es lo correcto conservar aunque el
 * tercero cambie de nombre o dirección después.
 */
model Solicitante {
  id                String             @id @default(cuid())
  tipo              TipoSolicitante
  identificacion    String             @unique // NIT o cédula, tal como se escribe (ej. "900123456-1")
  nombre            String // nombre completo o razón social
  regimenTributario RegimenTributario?
  granContribuyente Boolean            @default(false)
  email             String?
  telefono          String?
  direccion         String?
  municipio         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  expedientes Expediente[]
}

model Expediente {
  id             String   @id @default(cuid())
  numero         String   @unique // ej. M-DA-PR05-2026-0001
  tramiteTipoId  String
  flujoId        String

  solicitanteId             String? // vínculo al registro maestro por NIT/cédula (ver Solicitante) — null en expedientes creados antes de este campo
  solicitanteTipo           TipoSolicitante @default(NATURAL)
  solicitanteNombre         String
  solicitanteIdentificacion String
  solicitanteEmail          String?
  solicitanteTelefono       String?
  solicitanteDireccion      String? // dirección del solicitante — distinta de la del predio (ej. empresa con sede en otra ciudad)
  predioDireccion           String? // dirección del predio o del lugar donde se desarrolla el proyecto
  municipio                 String // uno de los 13 municipios de la jurisdicción CDMB (ver src/lib/municipios.ts)

  claseSolicitud   ClaseSolicitud? // Nueva / Renovación — el PDF del procedimiento no siempre lo distingue como flujo aparte

  // Datos del predio que el procedimiento oficial no siempre pide como tal, pero que sí importan
  // para la decisión real (ej. el área determina cuánta agua se puede conceder) o son identificadores
  // legales reales del predio — no están todos los trámites, por eso opcionales.
  predioNombre         String? // ej. "Finca La Esperanza" — un predio rural casi siempre tiene nombre propio, distinto de la dirección
  predioCatastral      String? // número catastral (IGAC)
  predioMatricula      String? // matrícula inmobiliaria
  predioAreaM2         Float?
  predioAreaCultivosM2 Float?
  predioAreaBosqueM2   Float?
  predioViviendas      Int?

  // Ubicación del predio/proyecto tomada en campo (mapa OSM) — opcional, no todo trámite la necesita.
  // Se puede cargar desde cualquiera de las 3 representaciones (elipsoidal/plana/cartesiana);
  // lat/lon (WGS84) es la que manda internamente, las demás se recalculan siempre en el
  // servidor a partir de ella — ver src/lib/coordenadas.ts. Sin altura: se probó y se quitó
  // a pedido del usuario (no la necesitan para nada de este trámite).
  ubicacionLat         Float? // elipsoidal WGS84
  ubicacionLon         Float? // elipsoidal WGS84
  ubicacionPlanaX      Float? // MAGNA-SIRGAS Origen-Nacional (EPSG:9377)
  ubicacionPlanaY      Float?
  ubicacionCartesianaX Float? // ECEF geocéntrica (mismo elipsoide GRS80)
  ubicacionCartesianaY Float?
  ubicacionCartesianaZ Float?

  // Dirección/ubicación del SOLICITANTE — distinta de la del predio/proyecto de arriba (ej.
  // una empresa con sede en Bucaramanga que solicita un permiso para un proyecto en Vetas).
  // Mismo esquema, misma lógica de recálculo en el servidor.
  solicitanteUbicacionLat         Float?
  solicitanteUbicacionLon         Float?
  solicitanteUbicacionPlanaX      Float?
  solicitanteUbicacionPlanaY      Float?
  solicitanteUbicacionCartesianaX Float?
  solicitanteUbicacionCartesianaY Float?
  solicitanteUbicacionCartesianaZ Float?

  estado           EstadoExpediente @default(RADICADO)
  pasoActualNumero Int              @default(1)

  createdById         String
  responsableActualId String?

  fechaRadicacion      DateTime  @default(now())
  fechaUltimoMovimiento DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tramiteTipo      TramiteTipo @relation(fields: [tramiteTipoId], references: [id])
  flujo            Flujo       @relation(fields: [flujoId], references: [id])
  creadoPor        Usuario     @relation("CreadoPor", fields: [createdById], references: [id])
  responsableActual Usuario?   @relation("ResponsableActual", fields: [responsableActualId], references: [id])
  solicitante      Solicitante? @relation(fields: [solicitanteId], references: [id])

  documentos ExpedienteDocumento[]
  eventos    ExpedienteEvento[]

  /**
   * Asignación del expediente completo (distinta de `responsableActual`, que
   * es solo "quién lo tiene ahora mismo" y cambia a medida que avanza de
   * paso). Esto es "quién(es) deben trabajar este expediente" — a uno o
   * varios usuarios puntuales, y/o a uno o varios cargos (cualquiera que
   * tenga ese cargo). Por ahora es solo informativo/visible: no bloquea a
   * nadie más para editar el expediente (decisión explícita del usuario —
   * convertir esto en una restricción real de permisos es un cambio
   * aparte, a confirmar antes de hacerlo).
   */
  usuariosAsignados Usuario[] @relation("ExpedienteUsuariosAsignados")
  cargosAsignados   Cargo[]   @relation("ExpedienteCargosAsignados")

  @@index([tramiteTipoId])
  @@index([estado])
  @@index([municipio])
  @@index([solicitanteId])
}

model ExpedienteDocumento {
  id            String   @id @default(cuid())
  expedienteId  String
  pasoNumero    Int?
  nombre        String
  descripcion   String?
  storagePath   String
  mimeType      String
  tamanoBytes   Int
  subidoPorId   String
  createdAt     DateTime @default(now())

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  subidoPor  Usuario    @relation(fields: [subidoPorId], references: [id])

  @@index([expedienteId])
}

enum TipoEvento {
  CREACION
  CAMBIO_ESTADO
  AVANCE_PASO
  DOCUMENTO_SUBIDO
  DOCUMENTO_ELIMINADO
  COMENTARIO
  ASIGNACION_CAMBIADA
}

model ExpedienteEvento {
  id             String     @id @default(cuid())
  expedienteId   String
  tipo           TipoEvento
  descripcion    String     @db.Text
  pasoNumero     Int?
  estadoAnterior EstadoExpediente?
  estadoNuevo    EstadoExpediente?
  usuarioId      String
  createdAt      DateTime   @default(now())

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])

  @@index([expedienteId])
}

// ---------------------------------------------------------------------------
// Integración VITAL/OTIC (MinAmbiente) — espejo de solo lectura de las
// solicitudes que el ciudadano radica en la Ventanilla Integral de Trámites
// Ambientales en Línea (VITAL), traídas vía los servicios web expuestos por
// X-ROAD (ver src/lib/vital.ts). Por ahora es de un solo sentido: se
// sincroniza PARA VER, no se reporta nada de vuelta a VITAL (eso — avance de
// actividad, asociación de radicado — quedó explícitamente fuera de alcance).
// ---------------------------------------------------------------------------

model SolicitudVital {
  id                 String    @id @default(cuid())
  idVital            String    @unique // número VITAL de la solicitud (idVital)
  idTramiteVital     Int // id_tramite en VITAL
  idTramiteAutoridad Int? // idTramiteAutoridad — identificador propio de la CDMB en VITAL, si aplica
  fechaRadicacion    DateTime?
  nombreActividad    String? // última actividad conocida al momento de sincronizar (hu-otic-vital-io-001)

  solicitanteNombre         String?
  solicitanteIdentificacion String?
  solicitanteCorreo         String?
  solicitanteRaw            Json? // respuesta completa de hu-otic-vital-io-003, tal cual (persona natural o jurídica)
  camposTramite              Json? // respuesta completa de hu-otic-vital-io-002, tal cual (campos del formulario)

  documentos           SolicitudVitalDocumento[]
  ultimaSincronizacion DateTime @default(now()) @updatedAt
  createdAt            DateTime @default(now())

  @@index([idTramiteVital])
}

model SolicitudVitalDocumento {
  id          String   @id @default(cuid())
  solicitudId String
  nombre      String
  storagePath String // ya descargado del link temporal de VITAL (expira en 1h) y re-subido a nuestro Storage
  mimeType    String
  tamanoBytes Int
  createdAt   DateTime @default(now())

  solicitud SolicitudVital @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@index([solicitudId])
}
